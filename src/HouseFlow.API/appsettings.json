{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "HouseFlowAPI",
    "Audience": "HouseFlowClient",
    "ExpiresInMinutes": 15
  },
  "DataRetention": {
    "IpAnonymizeAfterDays": 30,
    "RevokedRefreshTokenRetentionDays": 30,
    "RevokedApiKeyRetentionDays": 30,
    "AuditLogAnonymizeAfterDays": 365,
    "AuditLogDeleteAfterDays": 1095,
    "SoftDeletedRetentionDays": 30,
    "ExpiredInvitationRetentionDays": 30,
    "BatchSize": 500,
    "Cron": "0 3 * * *"
  }
}
