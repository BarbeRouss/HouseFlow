<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <!-- Message catalogs (copied verbatim from the former Next.js frontend's
         src/messages/*.json) are embedded so the localizer can read them
         synchronously at startup without an extra HTTP round-trip. -->
    <EmbeddedResource Include="Localization/Resources/fr.json" />
    <EmbeddedResource Include="Localization/Resources/en.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BlazorBlueprint.Components" Version="3.15.0" />
    <PackageReference Include="BlazorBlueprint.Icons.Lucide" Version="2.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.0-preview.7.25380.108" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0-preview.7.25380.108" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.0-preview.7.25380.108" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.0" />
  </ItemGroup>

  <!--
    Blazor WASM is a static SPA with no server-side process of its own, but the API's
    port is only known at run time (Aspire assigns it dynamically per environment/worktree).
    AppHost passes it via the API_BASE_URL environment variable (see HouseFlow.AppHost/Program.cs);
    this target writes it into wwwroot/appsettings.json before each build/run so
    WebAssemblyHostBuilder's default configuration loading picks it up (see Program.cs).

    This is for LOCAL DEVELOPMENT only. The deployed environments never set API_BASE_URL
    at build time: their published wwwroot is deliberately environment-agnostic, and
    scripts/ci/write-runtime-config.sh overwrites appsettings.json at deploy time, once
    Terraform knows the environment's API URL. Reintroducing API_BASE_URL into a CI
    `dotnet publish` would silently re-couple the artifact to one environment.
  -->
  <Target Name="WriteRuntimeConfig" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <ApiBaseUrl Condition="'$(API_BASE_URL)' != ''">$(API_BASE_URL)</ApiBaseUrl>
      <ApiBaseUrl Condition="'$(ApiBaseUrl)' == ''">http://localhost:5203</ApiBaseUrl>
      <DemoMode Condition="'$(DEMO_MODE)' != ''">$(DEMO_MODE)</DemoMode>
      <DemoMode Condition="'$(DemoMode)' == ''">false</DemoMode>
    </PropertyGroup>
    <WriteLinesToFile File="wwwroot/appsettings.json" Overwrite="true" Lines='{ &quot;ApiBaseUrl&quot;: &quot;$(ApiBaseUrl)&quot;, &quot;DemoMode&quot;: &quot;$(DemoMode)&quot; }' />
  </Target>

  <!--
    Tailwind's compiler is an npm CLI, so wwwroot/css/app.css (gitignored) is not
    produced by the .NET build on its own. This target compiles it during every
    `dotnet build`/`publish`, so the Blazor build alone yields correct styles with no
    separate `npm run build:css` step. It is incremental: it re-runs only when the
    Tailwind entrypoint/config or any markup Tailwind scans (see tailwind.config.js
    `content`) changed since the last output. Requires Node/npm on PATH.
  -->
  <ItemGroup>
    <TailwindInput Include="Styles/app.input.css;tailwind.config.js;postcss.config.js;package.json;wwwroot/index.html" />
    <TailwindInput Include="**/*.razor;**/*.razor.cs;Api/**/*.cs" Exclude="bin/**;obj/**" />
  </ItemGroup>

  <Target Name="BuildTailwindCss" BeforeTargets="BeforeBuild"
          Inputs="@(TailwindInput)" Outputs="wwwroot/css/app.css">
    <Message Importance="high" Text="Compiling Tailwind CSS (Styles/app.input.css -&gt; wwwroot/css/app.css)..." />
    <Exec Condition="!Exists('$(MSBuildProjectDirectory)/node_modules')"
          Command="npm ci" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Exec Command="npm run build:css" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

</Project>
