@inject TokenStore Tokens
@inject ThemeService Theme
@inject AppAuthStateProvider AuthState
@inject SessionRefresher Refresher
@inject NavigationManager Nav
@inject Localizer Localizer

@if (!_ready)
{
    @* Same look as the boot splash in index.html: the session is being restored. *@
    <div class="hf-splash">
        <div class="hf-splash-inner">
            <Logo Size="72" />
            <div class="hf-splash-brand">HouseFlow</div>
            <div class="hf-splash-label">@Localizer.Translate(AppRoutes.LocaleOf(Nav.Uri), "async.loading")</div>
        </div>
    </div>
}
else
{
    <CascadingAuthenticationState>
        <LocaleBoundary>
            <Router AppAssembly="@typeof(App).Assembly">
                <Found Context="routeData">
                    <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
                </Found>
                <NotFound>
                    @* P13 404: with the app chrome when signed in, public otherwise. *@
                    <LayoutView Layout="@typeof(ErrorLayout)">
                        <HouseFlow.Web.Features.Shared.NotFoundPage />
                    </LayoutView>
                </NotFound>
            </Router>
            <RetryIndicator />
        </LocaleBoundary>
    </CascadingAuthenticationState>
}

@code {
    private bool _ready;

    protected override async Task OnInitializedAsync()
    {
        await Theme.InitializeAsync();

        // The access token only lives in memory: on every boot (reload, new tab, browser
        // restart) exchange the HttpOnly refresh-token cookie for a new one — but only when a
        // previous visit left a session hint, so a logged-out visitor never waits on the API.
        if (await Tokens.HasSessionHintAsync())
            await RestoreSessionAsync();

        AuthState.NotifyChanged();
        _ready = true;
    }

    /// <summary>
    /// Boot restore, under the splash. Only a refusal of the cookie (401) ends the session. A
    /// throttled (429), failing (5xx) or unreachable API is retried within
    /// <see cref="SessionRefresher.Budget"/> (an ephemeral API cold-starts in ~30 s); past that the
    /// app starts logged out but keeps the hint, so the next boot tries again.
    /// </summary>
    private async Task RestoreSessionAsync()
    {
        var outcome = await Refresher.RefreshAsync();
        if (outcome.Status != RefreshStatus.Rejected) return;

        // The server rejected the cookie (expired, revoked, absent): the session is over.
        await Tokens.ClearAsync();
        // Art. 18: a restricted account must learn why it is logged out (P02 message).
        if (outcome.ErrorCode == ApiErrorCodes.AccountRestricted)
            await NavigateBeforeRouterAsync(AppRoutes.RestrictedLoginUrl(AppRoutes.CurrentLocale(Nav)));
    }

    /// <summary>
    /// In WebAssembly, NavigateTo updates <see cref="NavigationManager.Uri"/> only once the browser
    /// has acknowledged it (asynchronously). The Router reads the URI when it first renders, so wait
    /// for that acknowledgement — otherwise it would route the original URL (a protected page,
    /// which then redirects to the plain login page and loses the « compte suspendu » reason).
    /// </summary>
    private async Task NavigateBeforeRouterAsync(string url)
    {
        var changed = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
        void OnLocationChanged(object? sender, LocationChangedEventArgs e) => changed.TrySetResult();
        Nav.LocationChanged += OnLocationChanged;
        try
        {
            Nav.NavigateTo(url, replace: true);
            await Task.WhenAny(changed.Task, Task.Delay(TimeSpan.FromSeconds(2)));
        }
        finally
        {
            Nav.LocationChanged -= OnLocationChanged;
        }
    }
}
