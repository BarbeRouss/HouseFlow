@inherits LayoutComponentBase
@implements IDisposable
@inject TokenStore Tokens
@inject NavigationManager Nav
@inject AppAuthStateProvider AuthState

@if (Tokens.User is not null && !string.IsNullOrEmpty(Tokens.AccessToken))
{
    <div class="min-h-screen flex flex-col">
        <Header />
        @* Ré-acceptation des CGU / de la politique après publication d'une nouvelle version. *@
        <ConsentBanner />
        <div class="flex-1 flex flex-col">
            @Body
        </div>
        <Footer />
    </div>
}

@code {
    protected override void OnInitialized()
    {
        AuthState.AuthenticationStateChanged += OnAuthChanged;
        Guard();
    }

    private void OnAuthChanged(Task<AuthenticationState> _) => InvokeAsync(() =>
    {
        Guard();
        StateHasChanged();
    });

    private void Guard()
    {
        if (Tokens.User is null || string.IsNullOrEmpty(Tokens.AccessToken))
            Nav.NavigateTo($"/{CurrentLocale()}/login");
    }

    private string CurrentLocale()
    {
        var path = new Uri(Nav.Uri).AbsolutePath.Trim('/');
        var first = path.Split('/', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault();
        return first is "fr" or "en" ? first : "fr";
    }

    public void Dispose() => AuthState.AuthenticationStateChanged -= OnAuthChanged;
}
