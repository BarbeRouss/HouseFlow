@inherits LayoutComponentBase
@layout MainLayout
@inject TokenStore Tokens
@inject NavigationManager Nav
@inject RedirectGuard Redirect

@* Guest-only pages (P02 /login, P03 /register) inside the public layout (C7 footer).
   R6: a signed-in user opening them is sent to P07 — except an invitation link
   (/register?invitation={token}), which goes to P04 so they can accept it with this account, and
   a safe ?returnUrl=, which is honoured. *@
@if (!_authenticated)
{
    @Body
}

@code {
    private bool _authenticated;

    protected override void OnInitialized()
    {
        _authenticated = Tokens.User is not null && !string.IsNullOrEmpty(Tokens.AccessToken);
        if (_authenticated)
        {
            // A form that just authenticated handles its own redirect; don't interfere.
            if (Redirect.Consume()) return;
            var locale = AppRoutes.CurrentLocale(Nav);
            var token = InvitationToken();
            Nav.NavigateTo(token is null
                ? AppRoutes.AfterLogin(ReturnUrl(), locale)
                : $"/{locale}/invitations/{Uri.EscapeDataString(token)}", replace: true);
        }
    }

    /// <summary>
    /// A safe ?returnUrl= is honoured even when already signed in (e.g. an old tab on a login
    /// link): same destination as a fresh login. AfterLogin falls back to P07.
    /// </summary>
    private string? ReturnUrl() =>
        System.Web.HttpUtility.ParseQueryString(Nav.ToAbsoluteUri(Nav.Uri).Query)["returnUrl"];

    /// <summary>The ?invitation= token of /register (P03 invitation variant), if any.</summary>
    private string? InvitationToken()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        if (!uri.AbsolutePath.EndsWith("/register", StringComparison.OrdinalIgnoreCase)) return null;
        var token = System.Web.HttpUtility.ParseQueryString(uri.Query)["invitation"];
        return string.IsNullOrWhiteSpace(token) ? null : token;
    }
}
