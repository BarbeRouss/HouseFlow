<div class="@(Variant == "inline" ? "py-8" : "py-16") flex flex-col items-center justify-center text-center">
    @if (!string.IsNullOrEmpty(IconName))
    {
        <div class="w-16 h-16 rounded-2xl bg-gray-100 dark:bg-gray-800 flex items-center justify-center mb-4">
            <LucideIcon Name="@IconName" Class="h-8 w-8 text-gray-400" />
        </div>
    }
    <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-1">@Title</h3>
    @if (!string.IsNullOrEmpty(Description))
    {
        <p class="text-sm text-gray-500 dark:text-gray-400 max-w-sm mb-6">@Description</p>
    }
    @if (Action is not null)
    {
        @Action
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? IconName { get; set; }
    [Parameter] public string Variant { get; set; } = "default";
    [Parameter] public RenderFragment? Action { get; set; }
}
