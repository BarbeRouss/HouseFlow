@inherits AppComponentBase
@inject ApiService Api
@inject TokenStore Tokens
@inject AppAuthStateProvider AuthState

@* Bannière de ré-acceptation des CGU / de la politique de confidentialité pour les comptes
   créés avant l'introduction des documents versionnés, ou ayant accepté une version antérieure.

   Elle est volontairement NON bloquante (aucun overlay, aucune modale, le contenu reste
   utilisable) : l'EDPB qualifie de « deceptive design pattern » une (ré)acceptation imposée
   de façon bloquante (Lignes directrices 03/2022). Elle reste en revanche visible et
   persistante tant que l'utilisateur n'a pas accepté. *@
@if (Tokens.User?.ConsentRequired == true)
{
    <div role="region" aria-label="@T("consent.title")"
         class="border-b border-amber-200 dark:border-amber-900/60 bg-amber-50 dark:bg-amber-900/20">
        <div class="max-w-7xl mx-auto px-4 sm:px-8 py-3 flex flex-col sm:flex-row sm:items-center gap-3">
            <div class="flex items-start gap-3 flex-1">
                <LucideIcon Name="info" Class="h-5 w-5 shrink-0 mt-0.5 text-amber-600 dark:text-amber-400" />
                <p class="text-sm text-amber-900 dark:text-amber-100">
                    @T("consent.message", new { version = LegalConstants.PolicyVersion })
                    <a href="/@Locale/terms" target="_blank" rel="noopener noreferrer" class="font-medium underline hover:no-underline">@T("consent.termsLink")</a>
                    <span>@T("consent.and")</span>
                    <a href="/@Locale/privacy" target="_blank" rel="noopener noreferrer" class="font-medium underline hover:no-underline">@T("consent.privacyLink")</a>
                </p>
            </div>
            <div class="flex items-center gap-3 sm:shrink-0">
                @if (_error is not null)
                {
                    <span class="text-sm text-red-600 dark:text-red-400">@_error</span>
                }
                <button type="button" id="acceptUpdatedTerms" @onclick="Accept" disabled="@_busy"
                        class="rounded-md bg-amber-600 hover:bg-amber-700 disabled:bg-amber-400 px-4 py-2 text-sm font-medium text-white transition-colors">
                    @(_busy ? T("common.loading") : T("consent.accept"))
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool _busy;
    private string? _error;

    private async Task Accept()
    {
        _busy = true;
        _error = null;
        try
        {
            await Api.RecordConsentAsync(new ConsentRequest(true, LegalConstants.PolicyVersion));

            // Reflète l'acceptation dans la session courante : la bannière disparaît sans rechargement.
            if (Tokens.User is { } user && !string.IsNullOrEmpty(Tokens.AccessToken))
            {
                user.ConsentRequired = false;
                await Tokens.SetSessionAsync(Tokens.AccessToken, user);
                AuthState.NotifyChanged();
            }
        }
        catch (ApiException ex)
        {
            _error = string.IsNullOrWhiteSpace(ex.Message) ? T("consent.error") : ex.Message;
        }
        catch
        {
            _error = T("consent.error");
        }
        finally
        {
            _busy = false;
        }
    }
}
