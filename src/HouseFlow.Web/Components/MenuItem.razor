@* One entry of a MenuButton / OverflowMenu: a link when Href is set, a button otherwise.
   Clicking it closes the menu (the click bubbles to the menu container). *@
@if (Href is not null)
{
    <a href="@Href" role="@(Parent?.IsNavigation == true ? null : "menuitem")" tabindex="@(Parent?.IsNavigation == true ? null : "-1")"
       class="@ItemClass" data-testid="@TestId">
        @Icon()
        @ChildContent
    </a>
}
else
{
    <button type="button" role="@(Parent?.IsNavigation == true ? null : "menuitem")" tabindex="@(Parent?.IsNavigation == true ? null : "-1")"
            class="@ItemClass" data-testid="@TestId" disabled="@Disabled" @onclick="OnClick">
        @Icon()
        @ChildContent
    </button>
}

@code {
    [CascadingParameter] public MenuButton? Parent { get; set; }

    [Parameter] public string? Href { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Lucide icon name, e.g. "log-out".</summary>
    [Parameter] public string? IconName { get; set; }

    [Parameter] public bool Destructive { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? TestId { get; set; }

    private string ItemClass =>
        "flex w-full min-h-11 sm:min-h-9 items-center gap-2 whitespace-nowrap px-3 py-2 text-left text-sm cursor-pointer " +
        "hover:bg-accent focus:bg-accent focus:outline-hidden disabled:opacity-45 disabled:cursor-not-allowed " +
        (Destructive ? "text-destructive-strong" : "text-popover-foreground");

    private RenderFragment Icon() => builder =>
    {
        if (string.IsNullOrEmpty(IconName)) return;
        builder.OpenComponent<LucideIcon>(0);
        builder.AddAttribute(1, "Name", IconName);
        builder.AddAttribute(2, "Class", "h-4 w-4 shrink-0");
        builder.CloseComponent();
    };
}
