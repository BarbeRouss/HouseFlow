@* C6 skeleton primitive: pulsing muted block (opacity 1 → 0.5 / 1.2 s, off with
   prefers-reduced-motion — see .hf-skeleton in Styles/app.input.css). Decorative only: wrap
   a group of skeletons in an element carrying the "loading" status for assistive tech
   (AsyncSection does it). *@
<div class="hf-skeleton @(Circle ? "rounded-full" : "") @Class" style="@Style" aria-hidden="true"></div>

@code {
    /// <summary>CSS width, e.g. "45%", "120px".</summary>
    [Parameter] public string? Width { get; set; }

    /// <summary>CSS height, e.g. "10px".</summary>
    [Parameter] public string? Height { get; set; }

    [Parameter] public bool Circle { get; set; }
    [Parameter] public string? Class { get; set; }

    private string Style =>
        (Width is null ? "" : $"width:{Width};") + (Height is null ? "" : $"height:{Height};");
}
