@inherits AppComponentBase
@inject ApiService Api
@inject ILogger<HouseSelector> Logger

@* Breadcrumb house selector « [Maison des Lilas ▾] » (P09, P10): lists every house of the user,
   each item → P09 of that house, current one checked. The list is secondary data: until it
   arrives (or if it fails) the menu lists the current house only. 44 px tall under 640 px (R7). *@
<MenuButton AlignEnd="false" Navigation="true" AriaLabel="@T("houses.switchHouse")" TestId="house-selector" Class="min-w-0"
            TriggerClass="inline-flex max-w-[16rem] items-center gap-1 rounded-md border border-border bg-card px-2 py-0.5 text-sm text-foreground hover:bg-accent max-sm:min-h-11 max-sm:max-w-[12rem]">
    <Trigger>
        <span class="truncate">@HouseName</span>
        <LucideIcon Name="chevron-down" Class="h-3.5 w-3.5 shrink-0 text-muted-foreground" />
    </Trigger>
    <ChildContent>
        @foreach (var other in Houses)
        {
            <MenuItem Href="@($"/{Locale}/houses/{other.Id}")" TestId="house-selector-item">
                <span class="flex-1 truncate @(other.Id == HouseId ? "font-semibold" : "")">@(other.Id == HouseId ? HouseName : other.Name)</span>
                @if (other.Id == HouseId)
                {
                    <LucideIcon Name="check" Class="h-4 w-4 shrink-0 text-primary-strong" />
                }
            </MenuItem>
        }
    </ChildContent>
</MenuButton>

@code {
    [Parameter, EditorRequired] public string HouseId { get; set; } = "";

    /// <summary>Current name (kept in step after a rename: the list entry shows this value).</summary>
    [Parameter, EditorRequired] public string HouseName { get; set; } = "";

    private List<HouseSummary>? _houses;

    private IEnumerable<HouseSummary> Houses =>
        _houses is { Count: > 0 } list ? list : new[] { new HouseSummary { Id = HouseId, Name = HouseName } };

    protected override async Task OnInitializedAsync()
    {
        base.OnInitialized();
        try
        {
            _houses = (await Api.GetHousesAsync()).Houses
                .OrderBy(h => h.Name, StringComparer.CurrentCultureIgnoreCase).ToList();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or TaskCanceledException)
        {
            // Secondary list: the selector falls back to the current house only.
            Logger.LogWarning("House selector list unavailable: {Error}", ex.Message);
            _houses = null;
        }
    }
}
