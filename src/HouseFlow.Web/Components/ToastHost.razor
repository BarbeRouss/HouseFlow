@inherits AppComponentBase
@inject ToastService Toasts

@* C5 toast host, rendered once per layout. The aria-live region is always in the DOM so the
   screen reader announces each new message. Held on screen while hovered or focused. Above the
   mobile tab bar (C2) when AboveTabBar. Stacked above modals (z-50) so a toast raised while a modal
   is open (M5) stays visible and clickable; on mobile it then moves to the top, off the bottom
   sheet's buttons (see .hf-toast-region in Styles/app.input.css). *@
<div class="hf-toast-region pointer-events-none fixed inset-x-0 z-[60] flex justify-center px-4 @(AboveTabBar ? "bottom-[calc(66px+env(safe-area-inset-bottom))] sm:bottom-6" : "bottom-4 sm:bottom-6")"
     aria-live="polite" aria-atomic="true" role="status" aria-label="@T("toast.region")">
    @if (Toasts.Current is { } toast)
    {
        <div @key="toast.Id" class="pointer-events-auto flex w-full max-w-md sm:w-auto sm:max-w-xl items-center gap-3 rounded-[9px] bg-toast px-3.5 py-2.5 text-[13px] text-toast-foreground shadow-lg sm:text-sm"
             data-testid="@(toast.TestId ?? "toast")" data-error="@(toast.IsError ? "true" : null)"
             @onmouseenter="() => Toasts.SetHold(true)" @onmouseleave="() => Toasts.SetHold(false)"
             @onfocusin="() => Toasts.SetHold(true)" @onfocusout="() => Toasts.SetHold(false)">
            <span class="flex-1">@toast.Text</span>
            @foreach (var action in toast.Actions)
            {
                <button type="button" class="min-h-11 whitespace-nowrap text-toast-action underline underline-offset-2 hover:no-underline sm:min-h-0 focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-toast-action rounded-sm"
                        data-testid="@action.TestId" @onclick="() => Toasts.InvokeAsync(action)">
                    @action.Label
                </button>
            }
        </div>
    }
</div>

@code {
    /// <summary>True in the app layout (mobile tab bar at the bottom).</summary>
    [Parameter] public bool AboveTabBar { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Toasts.OnChange += OnToastChanged;
    }

    private void OnToastChanged() => InvokeAsync(StateHasChanged);

    public override void Dispose()
    {
        base.Dispose();
        Toasts.OnChange -= OnToastChanged;
    }
}
