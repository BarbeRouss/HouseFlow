@inherits AppComponentBase
@inject ThemeService Theme
@inject TokenStore Tokens
@inject ApiService Api
@inject ToastService Toasts

@* P11 Préférences · Thème: Clair / Sombre / Système (specs/ux), as a segmented radio group. Applied at
   once on this device (localStorage via ThemeService), then saved to the account. *@
<div role="radiogroup" aria-labelledby="@LabelId" class="hf-segmented" data-testid="theme-options">
    @foreach (var opt in Options)
    {
        var selected = Theme.Current == opt.Value;
        <button type="button" role="radio" aria-checked="@(selected ? "true" : "false")"
                class="hf-segment"
                data-testid="theme-@opt.Value" @onclick="() => SetTheme(opt.Value)">
            <LucideIcon Name="@opt.Icon" Size="16" />
            @T(opt.LabelKey)
        </button>
    }
</div>

@code {
    /// <summary>Id of the visible label of the group ("Thème").</summary>
    [Parameter, EditorRequired] public string LabelId { get; set; } = "";

    private static readonly (string Value, string LabelKey, string Icon)[] Options =
    {
        ("light", "settings.themeLight", "sun"),
        ("dark", "settings.themeDark", "moon"),
        ("system", "settings.themeSystem", "monitor"),
    };

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Theme.OnChange += OnThemeChanged;
    }

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    private async Task SetTheme(string value)
    {
        if (value == Theme.Current) return;
        await Theme.SetThemeAsync(value);
        if (Tokens.User is null || string.IsNullOrEmpty(Tokens.AccessToken)) return;
        try
        {
            await Api.UpdateUserSettingsAsync(new UserSettings { Theme = value, Language = Locale });
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or TaskCanceledException)
        {
            // The theme is applied locally anyway; only the account copy is stale.
            Toasts.ShowError(T("settings.preferenceSaveError"));
        }
    }

    public override void Dispose()
    {
        base.Dispose();
        Theme.OnChange -= OnThemeChanged;
    }
}
