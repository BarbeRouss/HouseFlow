@inherits AppComponentBase
@inject ThemeService Theme
@inject TokenStore Tokens
@inject ApiService Api
@inject ToastService Toasts

@* P11 Préférences · Thème: Automatique / Clair / Sombre, as a segmented radio group. Applied at
   once on this device (localStorage via ThemeService), then saved to the account. *@
<div role="radiogroup" aria-labelledby="@LabelId" class="inline-flex self-start rounded-md border border-input bg-card p-0.5 sm:self-auto" data-testid="theme-options">
    @foreach (var opt in Options)
    {
        var selected = Theme.Current == opt.Value;
        <button type="button" role="radio" aria-checked="@(selected ? "true" : "false")"
                class="inline-flex h-11 items-center gap-1.5 rounded px-3 text-sm font-medium transition-colors sm:h-8 focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring @(selected ? "bg-primary-soft text-primary-strong" : "text-muted-foreground hover:bg-accent hover:text-foreground")"
                data-testid="theme-@opt.Value" @onclick="() => SetTheme(opt.Value)">
            <LucideIcon Name="@opt.Icon" Class="h-4 w-4" />
            @T(opt.LabelKey)
        </button>
    }
</div>

@code {
    /// <summary>Id of the visible label of the group ("Thème").</summary>
    [Parameter, EditorRequired] public string LabelId { get; set; } = "";

    private static readonly (string Value, string LabelKey, string Icon)[] Options =
    {
        ("system", "settings.themeSystem", "monitor"),
        ("light", "settings.themeLight", "sun"),
        ("dark", "settings.themeDark", "moon"),
    };

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Theme.OnChange += OnThemeChanged;
    }

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    private async Task SetTheme(string value)
    {
        if (value == Theme.Current) return;
        await Theme.SetThemeAsync(value);
        if (Tokens.User is null || string.IsNullOrEmpty(Tokens.AccessToken)) return;
        try
        {
            await Api.UpdateUserSettingsAsync(new UserSettings { Theme = value, Language = Locale });
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or TaskCanceledException)
        {
            // The theme is applied locally anyway; only the account copy is stale.
            Toasts.ShowError(T("settings.preferenceSaveError"));
        }
    }

    public override void Dispose()
    {
        base.Dispose();
        Theme.OnChange -= OnThemeChanged;
    }
}
