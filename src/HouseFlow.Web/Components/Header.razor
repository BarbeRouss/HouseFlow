@inherits AppComponentBase
@inject TokenStore Tokens
@inject NavigationManager Nav
@inject NavCounterService Counters
@inject SessionService Session

@*
  C1 · Header (specs/ux C1). ≥ 640 px: 64 px, logo (global-status icon 28 px + « HouseFlow »), gap 28,
  entries « Accueil » (house, + R3 badge) and « Maisons » (building-2), avatar 36 px + first name pushed right
  (menu: Compte → P11, Administration for admins, Se déconnecter → P01). < 640 px: 56 px, logo only —
  the nav moves to the tab bar (C2). Background card, 1 px bottom border, no shadow.
  E2E hooks: initials inside <header>, full name in the menu, links « Compte » / « Administration »,
  text « Se déconnecter », nav-home / nav-houses, user-menu.
*@
<header class="sticky top-0 z-40 w-full border-b border-border bg-card">
    <div class="hf-gutter flex h-14 items-center gap-7 sm:h-16">
        <a href="/@Locale/dashboard" class="flex items-center gap-[9px] rounded-lg text-foreground no-underline focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring"
           aria-label="HouseFlow">
            <Logo Size="28" />
            <span class="font-display text-[19px] font-bold tracking-[-0.01em]">HouseFlow</span>
        </a>

        <nav class="hidden items-center gap-1 sm:flex" aria-label="@T("nav.main")">
            <a href="/@Locale/dashboard" class="@NavClass(NavSection.Home)" aria-current="@Current(NavSection.Home)" data-testid="nav-home">
                <LucideIcon Name="house" Class="size-[17px]" />
                @T("nav.home")
                <NavBadge />
            </a>
            <a href="/@Locale/houses" class="@NavClass(NavSection.Houses)" aria-current="@Current(NavSection.Houses)" data-testid="nav-houses">
                <LucideIcon Name="building-2" Class="size-[17px]" />
                @T("nav.houses")
            </a>
        </nav>

        @if (Tokens.User is { } user)
        {
            @* Label-in-name (WCAG 2.5.3): the visible first name starts the accessible name. *@
            <MenuButton Class="ml-auto max-sm:hidden" Navigation="true" AriaLabel="@($"{user.FirstName} · {T("nav.userMenu")}")" TestId="user-menu"
                        TriggerClass="inline-flex h-11 max-w-[14rem] items-center gap-2.5 rounded-full py-1 pl-1 pr-3.5 text-foreground transition-colors hover:bg-accent focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring">
                <Trigger>
                    <Avatar Name="@user.FullName" InitialsOverride="@user.Initials" Size="36" Highlight="@(_section == NavSection.Account)" Decorative="true" />
                    <span class="hidden truncate text-[15px] font-semibold sm:inline" data-testid="user-first-name">@user.FirstName</span>
                </Trigger>
                <ChildContent>
                    <div class="px-3.5 py-2 text-sm font-semibold text-foreground">@user.FullName</div>
                    <div class="my-1 h-px bg-divider"></div>
                    <MenuItem Href="@($"/{Locale}/settings")" IconName="circle-user">@T("nav.account")</MenuItem>
                    @if (user.IsAdmin)
                    {
                        <MenuItem Href="@($"/{Locale}/admin")" IconName="shield-check">@T("nav.admin")</MenuItem>
                    }
                    <div class="my-1 h-px bg-divider"></div>
                    <MenuItem OnClick="Logout" IconName="log-out" Destructive="true" TestId="logout">@T("nav.logout")</MenuItem>
                </ChildContent>
            </MenuButton>
        }
    </div>
</header>

@code {
    private NavSection _section;

    protected override async Task OnInitializedAsync()
    {
        base.OnInitialized();
        _section = AppRoutes.SectionOf(Nav.Uri);
        Nav.LocationChanged += OnLocationChanged;
        await Counters.EnsureLoadedAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var next = AppRoutes.SectionOf(e.Location);
        if (next == _section) return;
        _section = next;
        InvokeAsync(StateHasChanged);
    }

    // Entry: padding 8 × 14, radius 9, gap 8, 15/600. Active: primary-soft / primary-text. Inactive: muted.
    private string NavClass(NavSection s) =>
        "inline-flex h-11 items-center gap-2 rounded-[9px] px-3.5 text-[15px] font-semibold no-underline transition-colors " +
        "focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring " +
        (_section == s ? "bg-primary-soft text-primary-text" : "text-muted-foreground hover:bg-accent hover:text-foreground");

    private string? Current(NavSection s) => _section == s ? "page" : null;

    // R6 / C1: "Se déconnecter" → P01 (landing).
    private Task Logout() => Session.SignOutAsync();

    public override void Dispose()
    {
        base.Dispose();
        Nav.LocationChanged -= OnLocationChanged;
    }
}
