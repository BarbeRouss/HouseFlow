@inherits AppComponentBase
@inject TokenStore Tokens
@inject NavigationManager Nav
@inject NavCounterService Counters
@inject SessionService Session

@*
  C1 · Header (≥ 640 px): logo → P07, "Accueil" (+ R3 badge) and "Maisons", avatar menu
  (Compte → P11, Administration for admins, Se déconnecter → P01). Language and theme live in
  P11 now. Under 640 px the nav moves to the tab bar (C2) and this bar shrinks to a 46 px title bar.
  E2E hooks: initials + first name inside <header>, links "Compte" / "Administration",
  text "Se déconnecter".
*@
<header class="sticky top-0 z-40 w-full border-b border-border bg-card">
    <div class="mx-auto flex h-[46px] max-w-5xl items-center gap-1 px-4 sm:h-14 sm:gap-2 sm:px-6">
        <a href="/@Locale/dashboard" class="mr-2 flex items-center gap-2 rounded-md text-base font-semibold text-foreground sm:mr-4 sm:text-lg"
           aria-label="HouseFlow">
            <Logo Size="26" />
            <span class="@(MobileTitle is null ? "" : "hidden sm:inline")">HouseFlow</span>
        </a>
        @if (MobileTitle is not null)
        {
            <span class="text-base font-semibold text-foreground sm:hidden">@MobileTitle</span>
        }

        <nav class="hidden items-center gap-1 sm:flex" aria-label="@T("nav.main")">
            <a href="/@Locale/dashboard" class="@NavClass(NavSection.Home)" aria-current="@Current(NavSection.Home)" data-testid="nav-home">
                @T("nav.home")
                <NavBadge />
            </a>
            <a href="/@Locale/houses" class="@NavClass(NavSection.Houses)" aria-current="@Current(NavSection.Houses)" data-testid="nav-houses">
                @T("nav.houses")
            </a>
        </nav>

        @if (Tokens.User is { } user)
        {
            <MenuButton Class="ml-auto max-sm:hidden" Navigation="true" AriaLabel="@T("nav.userMenu")" TestId="user-menu"
                        TriggerClass="inline-flex h-9 items-center gap-2 rounded-md px-2 text-sm font-medium text-foreground hover:bg-accent focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring">
                <Trigger>
                    <Avatar Name="@user.FullName" InitialsOverride="@user.Initials" Size="28" Highlight="@(_section == NavSection.Account)" Decorative="true" />
                    <span>@user.FirstName</span>
                </Trigger>
                <ChildContent>
                    <div class="px-3 py-2 text-sm font-semibold text-foreground">@user.FullName</div>
                    <div class="my-1 h-px bg-border"></div>
                    <MenuItem Href="@($"/{Locale}/settings")" IconName="circle-user">@T("nav.account")</MenuItem>
                    @if (user.IsAdmin)
                    {
                        <MenuItem Href="@($"/{Locale}/admin")" IconName="shield-check">@T("nav.admin")</MenuItem>
                    }
                    <div class="my-1 h-px bg-border"></div>
                    <MenuItem OnClick="Logout" IconName="log-out" Destructive="true" TestId="logout">@T("nav.logout")</MenuItem>
                </ChildContent>
            </MenuButton>
        }
    </div>
</header>

@code {
    private NavSection _section;

    /// <summary>Mobile title bar text: the active section name.</summary>
    private string? MobileTitle => _section switch
    {
        NavSection.Home => T("nav.home"),
        NavSection.Houses => T("nav.houses"),
        NavSection.Account => T("nav.account"),
        _ => null,
    };

    protected override async Task OnInitializedAsync()
    {
        base.OnInitialized();
        _section = AppRoutes.SectionOf(Nav.Uri);
        Nav.LocationChanged += OnLocationChanged;
        await Counters.EnsureLoadedAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var next = AppRoutes.SectionOf(e.Location);
        if (next == _section) return;
        _section = next;
        InvokeAsync(StateHasChanged);
    }

    private string NavClass(NavSection s) =>
        "inline-flex h-9 items-center gap-1.5 rounded-md px-3 text-sm font-medium transition-colors " +
        (_section == s ? "bg-primary-soft text-primary-strong" : "text-muted-foreground hover:bg-accent hover:text-foreground");

    private string? Current(NavSection s) => _section == s ? "page" : null;

    // R6 / C1: "Se déconnecter" → P01 (landing).
    private Task Logout() => Session.SignOutAsync();

    public override void Dispose()
    {
        base.Dispose();
        Nav.LocationChanged -= OnLocationChanged;
    }
}
