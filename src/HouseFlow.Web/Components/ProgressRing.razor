@inherits AppComponentBase

@* R3 score ring (specs/ux « Anneau de score »): SVG viewBox 104, r 44, stroke 12, track `border`,
   progress `primary` (single colour, never a status colour), round caps, starts at −90°;
   « {à jour}/{total} » centred in Bricolage 700 (104 → 24 px · 64 → 15 · 56 → 13 · 54 → 12).
   No percentage. While UpToDate/Total are null (not loaded) a round skeleton of the same size is
   shown (C6: never an empty ring before the response). Optional « à jour » label beside it. *@
@if (UpToDate is null || Total is null)
{
    <div class="flex items-center gap-2 @LayoutClass @Class" aria-hidden="true">
        <div class="hf-skeleton shrink-0 rounded-full" style="width:@(Size)px;height:@(Size)px"></div>
    </div>
}
else
{
    <div class="flex items-center gap-2.5 @LayoutClass @Class" role="img" data-testid="progress-ring"
         aria-label="@T("score.fraction", new { upToDate = UpToDate, total = Total })">
        <div class="relative shrink-0" style="width:@(Size)px;height:@(Size)px" aria-hidden="true">
            <svg width="@Size" height="@Size" viewBox="0 0 104 104">
                <circle cx="52" cy="52" r="44" fill="none" class="stroke-border" stroke-width="12" />
                @if (_fraction > 0)
                {
                    <circle cx="52" cy="52" r="44" fill="none" class="stroke-primary" stroke-width="12" stroke-linecap="round"
                            stroke-dasharray="@Num(Circumference * _fraction) @Num(Circumference)" transform="rotate(-90 52 52)" />
                }
            </svg>
            <span class="absolute inset-0 flex items-center justify-center font-display font-bold tabular-nums text-foreground"
                  style="font-size:@(FontSize)px">@UpToDate/@Total</span>
        </div>
        @if (ShowLabel)
        {
            <span class="text-sm text-muted-foreground">@T("score.upToDate")</span>
        }
    </div>
}

@code {
    /// <summary>Number of up-to-date maintenances (null = not loaded).</summary>
    [Parameter] public int? UpToDate { get; set; }

    /// <summary>Total number of maintenances (null = not loaded).</summary>
    [Parameter] public int? Total { get; set; }

    /// <summary>« à jour » text beside the ring (off in the mockups' score cards, which carry their own text).</summary>
    [Parameter] public bool ShowLabel { get; set; } = true;

    /// <summary>Label under the ring below 640 px, beside it above.</summary>
    [Parameter] public bool Stacked { get; set; }

    /// <summary>Diameter in px: 64 (P07), 56 (P09), 104 (P01 preview), 54 (mobile preview).</summary>
    [Parameter] public int Size { get; set; } = 64;

    [Parameter] public string? Class { get; set; }

    private const double Circumference = 2 * Math.PI * 44; // ≈ 276.46

    private double _fraction;

    private string LayoutClass => Stacked ? "flex-col gap-1 sm:flex-row sm:gap-2.5" : "";

    private int FontSize => (int)Math.Round(Size * 0.232);

    protected override void OnParametersSet() =>
        _fraction = Total is > 0 && UpToDate is { } u ? Math.Clamp(u / (double)Total.Value, 0, 1) : 0;

    // SVG attributes are machine values, not display text: invariant formatting is correct here.
    private static string Num(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
}
