@* Round avatar with initials (C1 36 px, P09 34 px, P12 / M5 38 px) — specs/ux « Avatar ». Colour: a
   fixed pastel pair picked from the name (stable per person; same pair in both themes, like the
   mockups). Highlight = active state (C1 on P11: 2 px primary ring). Pending = invitation not yet
   accepted (M5): card background, muted « ? », 1.5 px dashed `input` border.
   Initials 13/700 at 36–38 px (≈ 0.36 × size). *@
@if (Pending)
{
    <span class="inline-flex shrink-0 select-none items-center justify-center rounded-full border-[1.5px] border-dashed border-input bg-card font-bold leading-none text-muted-foreground @Class"
          style="width:@(Size)px;height:@(Size)px;font-size:@(FontSize)px" title="@Name" aria-hidden="@(Decorative ? "true" : null)">?</span>
}
else
{
    var (bg, fg) = ColorsOf(Name ?? InitialsOverride);
    <span class="inline-flex shrink-0 select-none items-center justify-center rounded-full font-bold uppercase leading-none @(Highlight ? "ring-2 ring-primary ring-offset-2 ring-offset-card" : "") @Class"
          style="width:@(Size)px;height:@(Size)px;font-size:@(FontSize)px;background-color:@bg;color:@fg"
          title="@Name" aria-hidden="@(Decorative ? "true" : null)">@Initials</span>
}

@code {
    /// <summary>Full name; initials are derived from it unless <see cref="InitialsOverride"/> is set.</summary>
    [Parameter] public string? Name { get; set; }

    [Parameter] public string? InitialsOverride { get; set; }
    [Parameter] public int Size { get; set; } = 36;
    [Parameter] public bool Highlight { get; set; }

    /// <summary>Pending invitation (dashed outline, « ? »).</summary>
    [Parameter] public bool Pending { get; set; }

    /// <summary>True when the name is written next to the avatar (hidden from assistive tech).</summary>
    [Parameter] public bool Decorative { get; set; }

    [Parameter] public string? Class { get; set; }

    private string Initials => InitialsOverride ?? InitialsOf(Name);

    private string FontSize => Math.Max(10, Math.Round(Size * 0.36)).ToString("0", System.Globalization.CultureInfo.InvariantCulture);

    // Pastel pairs (background, text): the three of the mockups first, then three more of the same family.
    private static readonly (string Bg, string Fg)[] Palette =
    {
        ("#ffd9c2", "#9a3412"),
        ("#d6f0e0", "#166534"),
        ("#dbeafe", "#1e40af"),
        ("#ede9fe", "#5b21b6"),
        ("#fce7f3", "#9d174d"),
        ("#fef3c7", "#92400e"),
    };

    /// <summary>Stable pastel pair for a name (FNV-1a over the lower-cased name; not string.GetHashCode, which is randomised).</summary>
    public static (string Bg, string Fg) ColorsOf(string? name)
    {
        uint hash = 2166136261;
        foreach (var c in (name ?? "").Trim().ToLowerInvariant())
        {
            hash ^= c;
            hash *= 16777619;
        }
        return Palette[hash % (uint)Palette.Length];
    }

    public static string InitialsOf(string? name)
    {
        var parts = (name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..1],
            _ => $"{parts[0][0]}{parts[^1][0]}",
        };
    }
}
