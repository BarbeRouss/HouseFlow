@inherits AppComponentBase
@inject ApiService Api

@* M3 · Entretien réalisé — create (« Fait à une autre date… »: empty required date) or edit (toast
   « Ajouter des détails », P10 history row: pre-filled, « Supprimer » without confirmation when
   allowed). The API call happens here; the caller (MaintenanceActions) shows the C5 toasts.
   Look (specs/ux 4c / 4h): device tile + maintenance name + « appareil · maison »; Date · Coût (€
   suffix) side by side from 640 px; Prestataire with a styled suggestion list (combobox, providers
   already entered, typed part in bold); Note. The two GDPR hints stay under their fields. *@
<Modal Open="Open" OnClose="OnClose" TestId="record-modal" CompactTitle="true"
       Title="@(Item?.Name ?? "")" Description="@Subtitle"
       Error="@_error" PrimaryLabel="@T("recordModal.save")" PrimaryTestId="record-save"
       OnSubmit="SaveAsync" SubmitDisabled="!IsValid" Busy="_busy">
    <HeaderStart>
        @if (Item is not null)
        {
            <DeviceTile Type="@Item.DeviceType" Size="44" Class="max-sm:size-10! max-sm:rounded-[11px]!" />
        }
    </HeaderStart>
    <FooterStart>
        @if (IsEdit && Item?.CanDelete == true)
        {
            <button type="button" class="hf-btn hf-btn-danger-ghost -ml-2 px-2 max-sm:w-full" data-testid="record-delete"
                    disabled="@_busy" @onclick="DeleteAsync">
                <BusyLabel Busy="_deleting"><LucideIcon Name="trash-2" Size="16" /> @T("recordModal.delete")</BusyLabel>
            </button>
        }
    </FooterStart>
    <ChildContent>
        <div class="grid gap-4 @(ShowCosts ? "sm:grid-cols-2 sm:gap-3" : "")">
            <div class="min-w-0">
                <label class="hf-label" for="@($"{_id}-date")">@T("recordModal.date")</label>
                <input id="@($"{_id}-date")" type="date" lang="@Locale" class="hf-input" required data-testid="record-date"
                       max="@ParisClock.Today.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)"
                       aria-invalid="@(DateInFuture ? "true" : null)"
                       aria-describedby="@(DateInFuture ? $"{_id}-date-err" : null)"
                       @bind="_date" @bind:event="oninput" />
                @if (DateInFuture)
                {
                    <p id="@($"{_id}-date-err")" class="hf-field-error">@T("recordModal.dateFuture")</p>
                }
            </div>
            @if (ShowCosts)
            {
                <div class="min-w-0 max-sm:order-last">
                    <label class="hf-label" for="@($"{_id}-cost")">@T("recordModal.cost") <span class="hf-optional">@T("recordModal.optional")</span></label>
                    <div class="relative">
                        <input id="@($"{_id}-cost")" type="text" inputmode="decimal" class="hf-input pr-9 focus:pr-9" data-testid="record-cost"
                               aria-invalid="@(CostInvalid ? "true" : null)"
                               aria-describedby="@(CostInvalid ? $"{_id}-cost-err" : null)"
                               @bind="_cost" @bind:event="oninput" />
                        <span class="pointer-events-none absolute inset-y-0 right-3.5 flex items-center text-base text-muted-foreground sm:text-[15px]" aria-hidden="true">€</span>
                    </div>
                    @if (CostInvalid)
                    {
                        <p id="@($"{_id}-cost-err")" class="hf-field-error">@T("recordModal.costInvalid")</p>
                    }
                </div>
                <div class="min-w-0 sm:col-span-2">
                    <label class="hf-label" for="@($"{_id}-provider")">
                        @T("recordModal.provider") <span class="hf-optional">@T("recordModal.optional")</span>
                    </label>
                    <div class="relative">
                        <input id="@($"{_id}-provider")" type="text" class="hf-input" maxlength="200" autocomplete="off"
                               role="combobox" aria-autocomplete="list" aria-expanded="@(ListOpen ? "true" : "false")"
                               aria-controls="@($"{_id}-providers")"
                               aria-activedescendant="@(ListOpen && _active >= 0 ? $"{_id}-opt-{_active}" : null)"
                               data-testid="record-provider"
                               placeholder="@T("maintenance.providerPlaceholder")"
                               aria-describedby="@($"{_id}-provider-hint")"
                               value="@_provider" @oninput="OnProviderInput"
                               @onfocus="() => _listOpen = true" @onblur="() => _listOpen = false"
                               @onkeydown="OnProviderKeyDown"
                               @onkeydown:preventDefault="@(ListOpen && _active >= 0)"
                               @onkeydown:stopPropagation="ListOpen" />
                        @if (ListOpen)
                        {
                            <ul id="@($"{_id}-providers")" role="listbox" aria-label="@T("recordModal.suggestions")"
                                class="absolute inset-x-0 top-full z-10 mt-1.5 flex max-h-56 flex-col overflow-y-auto rounded-xl border border-border bg-card p-1.5 shadow-popover"
                                data-testid="record-provider-suggestions">
                                @for (var i = 0; i < Suggestions.Count; i++)
                                {
                                    var index = i;
                                    var s = Suggestions[i];
                                    <li id="@($"{_id}-opt-{index}")" role="option" aria-selected="@(index == _active ? "true" : "false")"
                                        class="flex min-h-11 cursor-pointer items-center gap-2.5 rounded-lg px-2.5 text-base text-foreground sm:text-[15px] @(index == _active ? "bg-primary-soft" : "hover:bg-accent")"
                                        @onmousedown="() => Pick(s)" @onmousedown:preventDefault="true">
                                        <LucideIcon Name="history" Size="15" Class="shrink-0 text-primary-text" />
                                        <span class="truncate">@Highlight(s)</span>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                    @* RGPD Art. 14(5)(b) — mesure compensatoire : n'inviter à saisir qu'une raison sociale. *@
                    <p id="@($"{_id}-provider-hint")" class="hf-help">@T("maintenance.providerHint")</p>
                </div>
            }
        </div>
        <div>
            <label class="hf-label" for="@($"{_id}-note")">
                @T("recordModal.note") <span class="hf-optional">@T("recordModal.optional")</span>
            </label>
            <textarea id="@($"{_id}-note")" class="hf-input h-[72px] min-h-[72px] py-3" rows="2" maxlength="@NoteMax" data-testid="record-note"
                      placeholder="@T("recordModal.notePlaceholder")"
                      aria-describedby="@($"{_id}-note-hint")"
                      @bind="_note" @bind:event="oninput"></textarea>
            @* RGPD Art. 5(1)(c) et 9 — un champ libre invite à la collecte incidente de données
               sensibles : le dissuader explicitement. *@
            <p id="@($"{_id}-note-hint")" class="hf-help">
                @T("maintenance.notesSensitiveDataHint")
                @if (_note.Length > NoteMax - 50)
                {
                    <span class="ml-1 tabular-nums">@_note.Length/@NoteMax</span>
                }
            </p>
        </div>
    </ChildContent>
</Modal>

@code {
    private const int NoteMax = 500;

    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>The maintenance type the record belongs to (title, rights).</summary>
    [Parameter] public MaintenanceRowItem? Item { get; set; }

    /// <summary>Null = create; set = edit this record.</summary>
    [Parameter] public MaintenanceInstance? Record { get; set; }

    /// <summary>Provider suggestions (providers already entered).</summary>
    [Parameter] public IReadOnlyList<string>? Providers { get; set; }

    /// <summary>After a successful create (IsNew = true) or edit.</summary>
    [Parameter] public EventCallback<RecordSaved> OnSaved { get; set; }

    /// <summary>After « Supprimer »: the deleted record (for the « Annuler » undo).</summary>
    [Parameter] public EventCallback<MaintenanceInstance> OnDeleted { get; set; }

    public sealed record RecordSaved(MaintenanceInstance Record, bool IsNew);

    private readonly string _id = "rec-" + Guid.NewGuid().ToString("N")[..8];
    private bool _wasOpen;
    private DateOnly? _date;
    private string _provider = "";
    private string _cost = "";
    private string _note = "";
    private string? _error;
    private bool _busy, _deleting;
    private bool _listOpen;
    private int _active = -1;

    private bool ShowCosts => Item?.CanViewCosts != false;

    /// <summary>« Chaudière gaz · Maison de Namur ».</summary>
    private string? Subtitle => Item is null ? null
        : string.IsNullOrWhiteSpace(Item.HouseName) ? Item.DeviceName : $"{Item.DeviceName} · {Item.HouseName}";

    /// <summary>Providers already entered that contain the typed text (the exact value excluded).</summary>
    private IReadOnlyList<string> Suggestions
    {
        get
        {
            var typed = _provider.Trim();
            return (Providers ?? Array.Empty<string>())
                .Where(p => !string.Equals(p, typed, StringComparison.OrdinalIgnoreCase)
                            && (typed.Length == 0 || p.Contains(typed, StringComparison.OrdinalIgnoreCase)))
                .Take(6)
                .ToList();
        }
    }

    private bool ListOpen => _listOpen && Suggestions.Count > 0;

    private void OnProviderInput(ChangeEventArgs e)
    {
        _provider = e.Value?.ToString() ?? "";
        _listOpen = true;
        _active = -1;
    }

    private void Pick(string provider)
    {
        _provider = provider;
        _listOpen = false;
        _active = -1;
    }

    /// <summary>Arrows move in the list, Enter picks the active option, Escape closes the list only.</summary>
    private void OnProviderKeyDown(KeyboardEventArgs e)
    {
        var count = Suggestions.Count;
        switch (e.Key)
        {
            case "ArrowDown" when count > 0:
                _listOpen = true;
                _active = (_active + 1) % count;
                break;
            case "ArrowUp" when count > 0:
                _listOpen = true;
                _active = _active <= 0 ? count - 1 : _active - 1;
                break;
            case "Enter" when ListOpen && _active >= 0 && _active < count:
                Pick(Suggestions[_active]);
                break;
            case "Escape" when ListOpen:
                _listOpen = false;
                _active = -1;
                break;
        }
    }

    /// <summary>The typed part in bold (« <b>Chauff</b>age Dumont »).</summary>
    private RenderFragment Highlight(string s) => __builder =>
    {
        var typed = _provider.Trim();
        var at = typed.Length == 0 ? -1 : s.IndexOf(typed, StringComparison.OrdinalIgnoreCase);
        if (at < 0)
        {
            <text>@s</text>
            return;
        }
        <text>@(s[..at])<strong class="font-bold">@(s.Substring(at, typed.Length))</strong>@(s[(at + typed.Length)..])</text>
    };

    private bool IsEdit => Record is not null;
    private bool DateInFuture => _date is { } d && d > ParisClock.Today;
    private bool CostInvalid => !string.IsNullOrWhiteSpace(_cost) && ParseCost(_cost, Locale) is null;
    private bool IsValid => Item is not null && _date is not null && !DateInFuture && !CostInvalid && _note.Length <= NoteMax;

    protected override void OnParametersSet()
    {
        if (Open && !_wasOpen) Reset();
        _wasOpen = Open;
    }

    private void Reset()
    {
        _error = null;
        _busy = _deleting = false;
        _listOpen = false;
        _active = -1;
        if (Record is { } r)
        {
            _date = DateFormatter.ParseDate(r.Date);
            _provider = r.Provider ?? "";
            _cost = r.Cost is { } c ? c.ToString("0.##", DateFormatter.Culture(Locale)) : "";
            _note = r.Notes ?? "";
        }
        else
        {
            _date = null;
            _provider = _cost = _note = "";
        }
    }

    /// <summary>
    /// Amount typed in the app locale; null when not a number ≥ 0. Spaces and « € » are ignored.
    /// fr: comma decimal (a dot is accepted too), space thousands — "120,50", "1 200" → 120.50, 1200.
    /// en: dot decimal, comma thousands — "120.50", "1,200" → 120.50, 1200.
    /// </summary>
    internal static decimal? ParseCost(string raw, string locale)
    {
        var s = raw.Trim().Replace("€", "").Replace(" ", "").Replace(" ", "").Replace(" ", "");
        var ok = locale == "en"
            ? decimal.TryParse(s, System.Globalization.NumberStyles.AllowDecimalPoint | System.Globalization.NumberStyles.AllowThousands,
                  System.Globalization.CultureInfo.GetCultureInfo("en-US"), out var v)
            : decimal.TryParse(s.Replace(',', '.'), System.Globalization.NumberStyles.AllowDecimalPoint,
                  System.Globalization.CultureInfo.InvariantCulture, out v);
        return ok && v >= 0 ? v : null;
    }

    internal static string ToApiDate(DateOnly d) =>
        d.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture) + "T00:00:00.000Z";

    private async Task SaveAsync()
    {
        if (!IsValid || _busy) return;
        _busy = true;
        _error = null;
        // Without CanViewCosts the fields are hidden: never send a cost or provider (m2 — the API
        // drops them too, on create as on edit).
        var cost = !ShowCosts || string.IsNullOrWhiteSpace(_cost) ? (decimal?)null : ParseCost(_cost, Locale);
        var provider = ShowCosts ? _provider.Trim() : "";
        var note = _note.Trim();
        try
        {
            MaintenanceInstance saved;
            if (Record is { } r)
            {
                // Replacement: an emptied field is cleared (provider / cost are ignored server side
                // for a caller who cannot see costs — the fields are hidden for them).
                saved = await Api.UpdateMaintenanceInstanceAsync(r.Id, new UpdateMaintenanceInstanceRequest
                {
                    Date = ToApiDate(_date!.Value),
                    Cost = cost,
                    Provider = provider.Length == 0 ? null : provider,
                    Notes = note.Length == 0 ? null : note,
                });
            }
            else
            {
                saved = await Api.LogMaintenanceAsync(Item!.TypeId, new LogMaintenanceRequest
                {
                    Date = ToApiDate(_date!.Value),
                    Cost = cost,
                    Provider = provider.Length == 0 ? null : provider,
                    Notes = note.Length == 0 ? null : note,
                });
            }
            _busy = false;
            await OnSaved.InvokeAsync(new RecordSaved(saved, Record is null));
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or TaskCanceledException)
        {
            _error = T("recordModal.saveError");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (Record is not { } r || _busy) return;
        _busy = _deleting = true;
        _error = null;
        try
        {
            await Api.DeleteMaintenanceInstanceAsync(r.Id);
            _busy = _deleting = false;
            await OnDeleted.InvokeAsync(r);
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or TaskCanceledException)
        {
            _error = T("recordModal.deleteError");
        }
        finally
        {
            _busy = _deleting = false;
        }
    }
}
