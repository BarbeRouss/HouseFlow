@inherits AppComponentBase
@inject NavigationManager Nav
@inject TokenStore Tokens
@inject ThemeService Theme
@inject ApiService Api
@inject ToastService Toasts

@* P11 Préférences · Langue: Français / English, as a segmented radio group. Saved to the
   account, then the /{locale} prefix of the URL is switched (same page). *@
<div role="radiogroup" aria-labelledby="@LabelId" class="inline-flex self-start rounded-md border border-input bg-card p-0.5 sm:self-auto" data-testid="language-options">
    @foreach (var l in Locales)
    {
        var selected = Locale == l.Code;
        <button type="button" role="radio" aria-checked="@(selected ? "true" : "false")" lang="@l.Code"
                class="inline-flex h-11 items-center rounded px-3 text-sm font-medium transition-colors sm:h-8 focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring @(selected ? "bg-primary-soft text-primary-strong" : "text-muted-foreground hover:bg-accent hover:text-foreground")"
                data-testid="language-@l.Code" @onclick="() => Switch(l.Code)">
            @l.Name
        </button>
    }
</div>

@code {
    /// <summary>Id of the visible label of the group ("Langue").</summary>
    [Parameter, EditorRequired] public string LabelId { get; set; } = "";

    /// <summary>Fragment kept after the switch (e.g. "preferences" to stay on the section).</summary>
    [Parameter] public string? Fragment { get; set; }

    private static readonly (string Code, string Name)[] Locales = { ("fr", "Français"), ("en", "English") };

    private async Task Switch(string newLocale)
    {
        if (newLocale == Locale) return;

        if (Tokens.User is not null && !string.IsNullOrEmpty(Tokens.AccessToken))
        {
            try
            {
                await Api.UpdateUserSettingsAsync(new UserSettings { Theme = Theme.Current, Language = newLocale });
            }
            catch (Exception ex) when (ex is ApiException or HttpRequestException or TaskCanceledException)
            {
                // The URL still switches; only the account copy is stale (next login restores it).
                Toasts.ShowError(T("settings.preferenceSaveError"));
            }
        }

        var path = new Uri(Nav.Uri).AbsolutePath;
        var newPath = System.Text.RegularExpressions.Regex.Replace(path, $"^/{Locale}(?=/|$)", $"/{newLocale}");
        Nav.NavigateTo(Fragment is null ? newPath : $"{newPath}#{Fragment}");
    }
}
