@inherits AppComponentBase

<nav class="flex items-center gap-2 text-sm mb-6 flex-wrap">
    <a href="/@Locale/dashboard" class="text-gray-500 hover:text-blue-600 dark:hover:text-blue-400 transition flex items-center gap-1">
        <LucideIcon Name="house" Class="h-4 w-4" />
        <span class="hidden sm:inline">@T("header.home")</span>
    </a>
    @foreach (var item in Items)
    {
        <div class="flex items-center gap-2">
            <LucideIcon Name="chevron-right" Class="h-4 w-4 text-gray-300" />
            @if (!string.IsNullOrEmpty(item.Href))
            {
                <a href="@item.Href" class="text-gray-500 hover:text-blue-600 transition">@item.Label</a>
            }
            else
            {
                <span class="text-gray-900 dark:text-white font-medium">@item.Label</span>
            }
        </div>
    }
</nav>

@code {
    [Parameter] public IReadOnlyList<Crumb> Items { get; set; } = Array.Empty<Crumb>();

    public sealed record Crumb(string Label, string? Href = null);
}
