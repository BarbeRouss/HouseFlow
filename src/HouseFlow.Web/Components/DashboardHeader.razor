@inherits AppComponentBase

@* P07 header: « {n} entretien(s) à traiter » / « dont {r} en retard » (or « Tout est à jour ·
   Prochain : … ») + the R3 ring. Shared by P07 and the P01 preview (DemoData), so the preview
   follows P07 automatically. *@
<div class="flex items-center justify-between gap-4 @Class" data-testid="dashboard-header">
    <div class="flex min-w-0 flex-col gap-0.5">
        @if (Summary.ToHandleCount == 0)
        {
            <h1 class="text-xl font-semibold text-foreground sm:text-2xl" data-testid="dashboard-title">@T("dashboard.allUpToDate")</h1>
            @if (Summary.NextTask is { } next)
            {
                <p class="text-sm text-muted-foreground" data-testid="dashboard-subtitle">
                    @T("dashboard.nextTask", new { name = next.MaintenanceTypeName, date = RelativeDate(next.NextDueDate) })
                </p>
            }
        }
        else
        {
            <h1 class="text-xl font-semibold text-foreground sm:text-2xl" data-testid="dashboard-title">
                <span class="sm:hidden">@T("dashboard.toHandleShort", new { count = Summary.ToHandleCount })</span>
                <span class="hidden sm:inline">@T("dashboard.toHandle", new { count = Summary.ToHandleCount })</span>
            </h1>
            @if (Summary.OverdueCount > 0)
            {
                <p class="text-sm text-muted-foreground" data-testid="dashboard-subtitle">@T("dashboard.overdueSubtitle", new { count = Summary.OverdueCount })</p>
            }
        }
    </div>
    @* No « 0/0 » ring when the houses have no maintenance at all (same rule as P09). *@
    @if (Summary.TotalCount > 0)
    {
        <ProgressRing UpToDate="Summary.UpToDateCount" Total="Summary.TotalCount" Stacked="true" />
    }
</div>

@code {
    [Parameter, EditorRequired] public HouseFlow.Web.Api.Dashboard Summary { get; set; } = default!;

    [Parameter] public string? Class { get; set; }
}
