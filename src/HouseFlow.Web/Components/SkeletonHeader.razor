@* C6 page-header skeleton (P07, P09, P10): title bar 60 %, subtitle bar 35 %, 46 px circle in
   place of the score ring. *@
<div class="flex items-center justify-between gap-4 @Class" aria-hidden="true">
    <div class="flex flex-1 flex-col gap-2">
        <Skeleton Width="60%" Height="22px" />
        <Skeleton Width="35%" Height="12px" />
    </div>
    @if (ShowRing)
    {
        <Skeleton Circle="true" Width="46px" Height="46px" Class="shrink-0" />
    }
</div>

@code {
    [Parameter] public bool ShowRing { get; set; } = true;
    [Parameter] public string? Class { get; set; }
}
