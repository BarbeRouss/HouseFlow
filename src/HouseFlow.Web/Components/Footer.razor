@inherits AppComponentBase

@* C7 · legal footer on every page (P01–P15), signed in or not. RGPD art. 12(1)/13: the privacy
   policy and the terms must be reachable everywhere without an account. In the flow at the
   bottom of the content, never fixed; under 640 px the links are centred and the app layout
   reserves the tab bar height below it. Labels: frozen footer.* keys. *@
<footer class="mt-auto w-full border-t border-border">
    <div class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-2 px-4 py-4 text-[13px] text-muted-foreground sm:flex-row sm:px-6">
        <p>@T("footer.copyright")</p>
        <nav class="flex flex-wrap items-center justify-center gap-x-4 gap-y-0 sm:gap-y-1">
            <a href="/@Locale/privacy" class="inline-flex min-h-11 items-center underline-offset-2 hover:text-foreground hover:underline sm:min-h-0 sm:py-1">@T("footer.privacy")</a>
            <a href="/@Locale/terms" class="inline-flex min-h-11 items-center underline-offset-2 hover:text-foreground hover:underline sm:min-h-0 sm:py-1">@T("footer.terms")</a>
            <a href="mailto:@LegalConstants.PrivacyContactEmail" class="inline-flex min-h-11 items-center underline-offset-2 hover:text-foreground hover:underline sm:min-h-0 sm:py-1">@LegalConstants.PrivacyContactEmail</a>
        </nav>
    </div>
</footer>
