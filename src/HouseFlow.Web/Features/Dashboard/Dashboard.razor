@page "/{Locale}/dashboard"
@layout DashboardLayout
@inherits AppComponentBase
@inject ApiService Api
@inject NavCounterService NavCounter
@inject TokenStore Tokens

@* P07 · Accueil — « qu'est-ce que je dois faire ? » and do it without leaving the page (specs/ux P07).
   Header « Bonjour {prénom} » / « {n} entretien(s) à traiter » / « dont {r} en retard » + score card
   (ring « x/y », « entretiens à jour », « sur {n} maisons », R3); every task to handle in C3 rows,
   in two framed lists under « EN RETARD » / « DANS LES 30 JOURS »; « Mes maisons » as C4 cards
   (1 / 2 / 3 columns) + « Tout voir » → P08. n = 0 → « Tout est à jour · Prochain : … »;
   no house → the « Commencer » block only. *@
<div class="hf-gutter mx-auto flex w-full max-w-app flex-col gap-[26px] pb-11 pt-7" data-testid="dashboard-page">
    <MaintenanceActions OnChanged="ReloadAsync">
        <AsyncSection @ref="_section" TItem="HomeData" Load="LoadAsync" HandleNotFound="false"
                      IsEmpty="d => d.Houses.Count == 0">
            <Loading>
                <div class="flex flex-col gap-[26px]">
                    <SkeletonHeader />
                    <div class="flex flex-col gap-2.5">
                        <Skeleton Width="110px" Height="13px" />
                        <SkeletonRows ShowTile="true" ShowTrailing="true" />
                    </div>
                    <div class="flex flex-col gap-3.5">
                        <Skeleton Width="140px" Height="22px" />
                        <SkeletonHouseCards />
                    </div>
                </div>
            </Loading>
            <Empty>
                <div class="hf-card flex flex-col items-center gap-2 px-6 py-10 text-center" data-testid="dashboard-empty">
                    <h1 class="hf-h2 text-foreground">@T("dashboard.emptyTitle")</h1>
                    <p class="text-base text-muted-foreground">@T("dashboard.emptyText")</p>
                    <a href="/@Locale/setup/house" class="hf-btn hf-btn-primary mt-3" data-testid="dashboard-start">@T("dashboard.start")</a>
                </div>
            </Empty>
            <ChildContent Context="data">
                <div class="flex flex-col gap-[26px]">
                    <DashboardHeader Summary="data.Dashboard" Greeting="@Tokens.User?.FirstName" HousesCount="data.Houses.Count" />

                    @if (data.Dashboard.Tasks.Count > 0)
                    {
                        <div class="flex flex-col gap-[22px]" data-testid="dashboard-tasks">
                            @TaskGroup("dashboard.groupOverdue", "overdue", "text-late", data.Overdue)
                            @TaskGroup("dashboard.groupDueSoon", "due", "text-due", data.DueSoon)
                        </div>
                    }

                    <section class="flex flex-col gap-3.5" aria-labelledby="dashboard-houses-title">
                        <div class="flex items-baseline justify-between gap-3">
                            <h2 id="dashboard-houses-title" class="hf-h2 text-foreground">@T("dashboard.housesTitle")</h2>
                            <a href="/@Locale/houses" class="py-2.5 text-[15px] font-semibold text-primary-text no-underline hover:underline"
                               data-testid="dashboard-houses-all">@T("dashboard.housesAll")</a>
                        </div>
                        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-testid="dashboard-houses">
                            @foreach (var house in HouseCard.Sort(data.Houses))
                            {
                                <HouseCard @key="house.Id" House="house" />
                            }
                        </div>
                    </section>
                </div>
            </ChildContent>
        </AsyncSection>
    </MaintenanceActions>
</div>

@code {
    [Parameter] public new string Locale { get; set; } = "fr";

    private AsyncSection<HomeData>? _section;

    /// <summary>GET /dashboard (tasks + R3 counters) and GET /houses (C4 cards), loaded together.</summary>
    private sealed record HomeData(HouseFlow.Web.Api.Dashboard Dashboard, List<HouseSummary> Houses,
        List<MaintenanceRowItem> Overdue, List<MaintenanceRowItem> DueSoon);

    private async Task<HomeData> LoadAsync()
    {
        var dashboardTask = Api.GetDashboardAsync();
        var housesTask = Api.GetHousesAsync();
        var dashboard = await dashboardTask;
        var houses = (await housesTask).Houses;
        NavCounter.SetFrom(dashboard);

        // Each task carries the caller's R5 rights on its house (C5 « Annuler », M3 provider / cost).
        var items = dashboard.Tasks
            .OrderBy(t => DateFormatter.ParseDate(t.NextDueDate) ?? DateOnly.MaxValue)
            .Select(t => MaintenanceRowItem.From(t))
            .ToList();
        return new HomeData(dashboard, houses,
            items.Where(i => i.DueStatus == DueStatus.Overdue).ToList(),
            items.Where(i => i.DueStatus != DueStatus.Overdue).ToList());
    }

    private async Task ReloadAsync()
    {
        // ReloadAsync keeps the rows on screen (no skeleton) and pushes the fresh counters to the nav.
        if (_section is not null) await _section.ReloadAsync();
        else await NavCounter.RefreshAsync();
    }

    /// <summary>« EN RETARD » / « DANS LES 30 JOURS » label (13/700 uppercase, status colour) + framed C3 list.</summary>
    private RenderFragment TaskGroup(string labelKey, string testId, string colorClass, List<MaintenanceRowItem> items) => __builder =>
    {
        if (items.Count == 0) return;
        <div class="flex flex-col gap-2.5" role="group" aria-labelledby="@($"group-{testId}")" data-testid="@($"group-{testId}")">
            <h2 id="@($"group-{testId}")" class="hf-section-label @colorClass">@T(labelKey)</h2>
            <div class="hf-box">
                @foreach (var item in items)
                {
                    <MaintenanceRow @key="item.TypeId" Item="item" Context="MaintenanceRowContext.Dashboard" />
                }
            </div>
        </div>
    };
}
