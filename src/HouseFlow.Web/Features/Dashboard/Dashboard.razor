@page "/{Locale}/dashboard"
@layout DashboardLayout
@inherits AppComponentBase
@inject ApiService Api
@inject NavCounterService NavCounter

@* P07 · Accueil — « qu'est-ce que je dois faire ? » and do it without leaving the page.
   Header « {n} entretien(s) à traiter » / « dont {r} en retard » + ring « x/y à jour » (R3);
   every task to handle in C3 rows, grouped « En retard » then « Dans les 30 jours »; « Mes maisons »
   in C4 rows. n = 0 → « Tout est à jour · Prochain : … »; no house → the « Commencer » block only. *@
<div class="mx-auto flex w-full max-w-[580px] flex-col gap-4 px-4 py-6 sm:py-8" data-testid="dashboard-page">
    <MaintenanceActions OnChanged="ReloadAsync">
        <AsyncSection @ref="_section" TItem="HomeData" Load="LoadAsync" HandleNotFound="false"
                      IsEmpty="d => d.Houses.Count == 0">
            <Loading>
                <div class="flex flex-col gap-4">
                    <SkeletonHeader />
                    <SkeletonRows />
                    <Skeleton Width="30%" Height="18px" Class="mt-2" />
                    <SkeletonRows ShowTrailing="true" />
                </div>
            </Loading>
            <Empty>
                <div class="hf-box flex flex-col items-center gap-2 px-5 py-8 text-center" data-testid="dashboard-empty">
                    <h1 class="text-lg font-semibold text-foreground">@T("dashboard.emptyTitle")</h1>
                    <p class="text-sm text-muted-foreground">@T("dashboard.emptyText")</p>
                    <a href="/@Locale/setup/house" class="hf-btn hf-btn-primary mt-2" data-testid="dashboard-start">@T("dashboard.start")</a>
                </div>
            </Empty>
            <ChildContent Context="data">
                @{ var home = data.Dashboard; }
                <DashboardHeader Summary="home" />

                @if (home.Tasks.Count > 0)
                {
                    <div class="hf-box" data-testid="dashboard-tasks">
                        @TaskGroup("dashboard.groupOverdue", "overdue", data.Overdue)
                        @TaskGroup("dashboard.groupDueSoon", "due", data.DueSoon)
                    </div>
                }

                <h2 class="mt-2 text-lg font-semibold text-foreground">@T("dashboard.housesTitle")</h2>
                <div class="hf-box" data-testid="dashboard-houses">
                    @foreach (var house in HouseRow.Sort(data.Houses))
                    {
                        <HouseRow @key="house.Id" House="house" />
                    }
                </div>
            </ChildContent>
        </AsyncSection>
    </MaintenanceActions>
</div>

@code {
    [Parameter] public new string Locale { get; set; } = "fr";

    private AsyncSection<HomeData>? _section;

    /// <summary>GET /dashboard (tasks + R3 counters) and GET /houses (C4 rows), loaded together.</summary>
    private sealed record HomeData(HouseFlow.Web.Api.Dashboard Dashboard, List<HouseSummary> Houses,
        List<MaintenanceRowItem> Overdue, List<MaintenanceRowItem> DueSoon);

    private async Task<HomeData> LoadAsync()
    {
        var dashboardTask = Api.GetDashboardAsync();
        var housesTask = Api.GetHousesAsync();
        var dashboard = await dashboardTask;
        var houses = (await housesTask).Houses;
        NavCounter.SetFrom(dashboard);

        // Each task carries the caller's R5 rights on its house (C5 « Annuler », M3 provider / cost).
        var items = dashboard.Tasks
            .OrderBy(t => DateFormatter.ParseDate(t.NextDueDate) ?? DateOnly.MaxValue)
            .Select(t => MaintenanceRowItem.From(t))
            .ToList();
        return new HomeData(dashboard, houses,
            items.Where(i => i.DueStatus == DueStatus.Overdue).ToList(),
            items.Where(i => i.DueStatus != DueStatus.Overdue).ToList());
    }

    private async Task ReloadAsync()
    {
        // ReloadAsync keeps the rows on screen (no skeleton) and pushes the fresh counters to the nav.
        if (_section is not null) await _section.ReloadAsync();
        else await NavCounter.RefreshAsync();
    }

    private RenderFragment TaskGroup(string labelKey, string testId, List<MaintenanceRowItem> items) => __builder =>
    {
        if (items.Count == 0) return;
        <div role="group" aria-labelledby="@($"group-{testId}")" data-testid="@($"group-{testId}")">
            <div id="@($"group-{testId}")" class="hf-group-label">@T(labelKey)</div>
            @foreach (var item in items)
            {
                <MaintenanceRow @key="item.TypeId" Item="item" Context="MaintenanceRowContext.Dashboard" />
            }
        </div>
    };
}
