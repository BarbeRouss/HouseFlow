@inherits AppComponentBase

<div class="min-h-screen flex items-center justify-center bg-gray-50 dark:bg-gray-900 p-8">
    <div class="text-center max-w-md">
        <p class="text-7xl font-bold text-gray-200 dark:text-gray-700 mb-2">404</p>
        <h1 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">@T("errors.notFoundTitle")</h1>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-8">@T("errors.notFoundDescription")</p>
        <a href="/" class="inline-block rounded-lg bg-gradient-to-r from-blue-500 to-blue-600 px-6 py-2.5 text-sm font-medium text-white hover:from-blue-600 hover:to-blue-700 transition-all">
            @T("errors.backToHome")
        </a>
    </div>
</div>
