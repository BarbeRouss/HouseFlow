@inject NavigationManager Nav
@inject TokenStore Tokens

@* P13 404 for unknown routes (App.razor <NotFound>, rendered inside ErrorLayout, and P01 for a
   single unknown segment). An app page without its locale (/dashboard, /houses/{id},
   /invitations/{token}…: old bookmarks, links from before the /{locale} prefix) is sent to the same
   page under the user's language (fr by default), query kept, instead of a 404. *@
@if (!_redirecting)
{
    <ErrorPage Code="404" />
}

@code {
    private bool _redirecting;

    protected override void OnParametersSet()
    {
        var language = Tokens.User?.Language;
        var locale = Localizer.IsSupported(language) ? language! : Localizer.DefaultLocale;
        var target = AppRoutes.LocalelessRedirect(Nav.ToBaseRelativePath(Nav.Uri), locale);
        _redirecting = target is not null;
        if (target is not null) Nav.NavigateTo(target, replace: true);
    }
}
