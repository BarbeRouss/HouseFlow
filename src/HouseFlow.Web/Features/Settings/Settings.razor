@page "/{Locale}/settings"
@layout DashboardLayout
@inherits AppComponentBase
@inject ApiService Api
@inject IJSRuntime JS

<div class="min-h-screen bg-gray-50 dark:bg-gray-900 p-4 sm:p-8">
    <div class="max-w-3xl mx-auto space-y-6">
        <h1 class="text-3xl font-bold text-gray-900 dark:text-white">@T("settings.title")</h1>

        @if (_createdKey is not null)
        {
            <div class="rounded-xl border border-green-200 dark:border-green-800 bg-green-50 dark:bg-green-950 p-6">
                <p class="font-semibold text-green-800 dark:text-green-200">@T("apiKeys.keyCreated")</p>
                <p class="text-sm text-green-700 dark:text-green-300 mt-1">@T("apiKeys.keyCreatedWarning")</p>
                <div class="mt-3 flex items-center gap-2">
                    <code class="flex-1 min-w-0 bg-white dark:bg-gray-900 border border-green-300 dark:border-green-700 rounded px-3 py-2 text-sm font-mono break-all select-all">@_createdKey</code>
                    <button type="button" @onclick="CopyKey" class="shrink-0 inline-flex items-center gap-1 rounded-md border border-gray-300 dark:border-gray-600 px-3 py-2 text-sm">
                        <LucideIcon Name="@(_copied ? "check" : "copy")" Class="h-4 w-4" /> @(_copied ? T("apiKeys.copied") : T("apiKeys.copy"))
                    </button>
                </div>
                <div class="mt-2 flex justify-end">
                    <button type="button" @onclick="() => _createdKey = null" class="text-sm text-gray-600 dark:text-gray-300 hover:underline">@T("common.close")</button>
                </div>
            </div>
        }

        <div class="rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 shadow-sm">
            <div class="p-6 border-b border-gray-100 dark:border-gray-700">
                <div class="flex items-center justify-between">
                    <div>
                        <h2 class="text-lg font-bold text-gray-900 dark:text-white flex items-center gap-2"><LucideIcon Name="key" Class="h-5 w-5" /> @T("apiKeys.title")</h2>
                        <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">@T("apiKeys.description")</p>
                    </div>
                    @if (!_showCreate && !_limitReached)
                    {
                        <button type="button" @onclick="() => _showCreate = true" class="inline-flex items-center rounded-md bg-primary px-3 py-2 text-sm font-medium text-white">
                            <LucideIcon Name="plus" Class="h-4 w-4 mr-1" /> @T("apiKeys.create")
                        </button>
                    }
                </div>
                @if (_limitReached)
                {
                    <p class="text-sm text-amber-600 dark:text-amber-400 mt-2">@T("apiKeys.limitReached")</p>
                }
            </div>

            <div class="p-6 space-y-3">
                @if (_showCreate)
                {
                    <div class="mb-2 p-4 border border-gray-200 dark:border-gray-700 rounded-lg bg-gray-50 dark:bg-gray-800/50 space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">@T("apiKeys.name")</label>
                            <input @bind="_name" @bind:event="oninput" maxlength="100" placeholder="@T("apiKeys.namePlaceholder")"
                                   class="w-full px-3 py-2 rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 text-sm dark:text-white" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">@T("apiKeys.scope")</label>
                            <div class="flex gap-4">
                                <label class="flex items-center gap-2 cursor-pointer text-sm">
                                    <input type="radio" name="scope" checked="@(_scope == "ReadWrite")" @onchange='() => _scope = "ReadWrite"' />
                                    <LucideIcon Name="shield-check" Class="h-4 w-4 text-blue-600 dark:text-blue-400" /> @T("apiKeys.scopeReadWrite")
                                </label>
                                <label class="flex items-center gap-2 cursor-pointer text-sm">
                                    <input type="radio" name="scope" checked="@(_scope == "ReadOnly")" @onchange='() => _scope = "ReadOnly"' />
                                    <LucideIcon Name="shield" Class="h-4 w-4 text-gray-500" /> @T("apiKeys.scopeReadOnly")
                                </label>
                            </div>
                        </div>
                        <div class="flex gap-2 justify-end">
                            <button type="button" @onclick="CancelCreate" class="rounded-md border border-gray-300 dark:border-gray-600 px-3 py-2 text-sm">@T("common.cancel")</button>
                            <button type="button" @onclick="Create" disabled="@(string.IsNullOrWhiteSpace(_name) || _busy)" class="rounded-md bg-primary px-3 py-2 text-sm text-white disabled:opacity-50">@(_busy ? T("common.loading") : T("apiKeys.create"))</button>
                        </div>
                    </div>
                }

                @if (_loading)
                {
                    <p class="text-gray-500">@T("common.loading")</p>
                }
                else if (_keys.Count == 0)
                {
                    <EmptyState IconName="key" Title="@T("apiKeys.noKeys")" Description="@T("apiKeys.noKeysDescription")" />
                }
                else
                {
                    @foreach (var key in _keys)
                    {
                        <div class="flex items-center justify-between p-3 bg-gray-50 dark:bg-gray-700/50 rounded-lg">
                            <div class="min-w-0">
                                <p class="font-medium text-gray-900 dark:text-white truncate">@key.Name</p>
                                <p class="text-xs text-gray-500 dark:text-gray-400">
                                    @key.Prefix… · @key.Scope · @T("apiKeys.lastUsed"): @(string.IsNullOrEmpty(key.LastUsedAt) ? T("apiKeys.never") : FormatDate(key.LastUsedAt))
                                </p>
                            </div>
                            <button type="button" @onclick="() => _revokeId = key.Id" title="@T("apiKeys.revoke")" class="inline-flex h-8 w-8 items-center justify-center rounded-md text-red-600 hover:bg-red-50 dark:hover:bg-red-900/20">
                                <LucideIcon Name="trash-2" Class="h-4 w-4" />
                            </button>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<Modal Open="@(_revokeId is not null)" OnClose="() => _revokeId = null">
    <div class="p-6">
        <h2 class="text-lg font-bold text-gray-900 dark:text-white mb-2">@T("apiKeys.revokeTitle")</h2>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">@T("apiKeys.revokeConfirm")</p>
        <div class="flex gap-3">
            <button type="button" @onclick="() => _revokeId = null" class="flex-1 rounded-md border border-gray-300 dark:border-gray-600 px-4 py-2 text-sm">@T("common.cancel")</button>
            <button type="button" @onclick="ConfirmRevoke" class="flex-1 rounded-md bg-red-600 px-4 py-2 text-sm text-white">@T("apiKeys.revoke")</button>
        </div>
    </div>
</Modal>

@code {
    [Parameter] public string Locale { get; set; } = "fr";

    private bool _loading = true;
    private bool _showCreate;
    private bool _busy;
    private bool _copied;
    private string _name = "";
    private string _scope = "ReadWrite";
    private string? _createdKey;
    private string? _revokeId;
    private List<ApiKey> _keys = new();

    private bool _limitReached => _keys.Count >= 5;

    protected override async Task OnInitializedAsync()
    {
        base.OnInitialized();
        await Load();
    }

    private async Task Load()
    {
        try { _keys = await Api.GetApiKeysAsync(); } catch { _keys = new(); }
        finally { _loading = false; }
    }

    private void CancelCreate() { _showCreate = false; _name = ""; _scope = "ReadWrite"; }

    private async Task Create()
    {
        if (string.IsNullOrWhiteSpace(_name)) return;
        _busy = true;
        try
        {
            var res = await Api.CreateApiKeyAsync(new CreateApiKeyRequest { Name = _name.Trim(), Scope = _scope });
            _createdKey = res.Key;
            _copied = false;
            CancelCreate();
            await Load();
        }
        catch { }
        finally { _busy = false; }
    }

    private async Task CopyKey()
    {
        if (_createdKey is null) return;
        await JS.InvokeVoidAsync("hf.copyToClipboard", _createdKey);
        _copied = true;
    }

    private async Task ConfirmRevoke()
    {
        var id = _revokeId;
        _revokeId = null;
        if (id is null) return;
        try { await Api.RevokeApiKeyAsync(id); await Load(); } catch { }
    }

    private static string FormatDate(string iso) =>
        DateTime.TryParse(iso, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.AdjustToUniversal, out var d)
            ? d.ToString("d MMM yyyy", System.Globalization.CultureInfo.InvariantCulture) : iso;
}
