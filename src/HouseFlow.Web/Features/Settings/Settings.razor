@page "/{Locale}/settings"
@layout DashboardLayout
@inherits AppComponentBase
@inject TokenStore Tokens
@inject IJSRuntime JS
@inject SessionService Session

@* P11 · Compte (specs/ux P11): one 720 px column, no side menu — six short cards read by scrolling,
   anchors kept in the URL: #profil, #preferences, #donnees, #api, #applications (OAuth, #304),
   #suppression (always last).
   #rappels (email reminders) is out of scope: it will slot in between #profil and #preferences.
   Under 640 px the header has no avatar menu: « Administration » (admins) and « Se déconnecter »
   stay reachable in a short card at the end of the column (C2 « Compte » tab leads here). *@
<div class="hf-gutter mx-auto flex w-full max-w-reading flex-col gap-[18px] pb-11 pt-7" data-testid="settings-page">
    <h1 class="hf-h1 text-foreground">@T("nav.account")</h1>

    <section id="profil" class="@CardClass" aria-labelledby="profil-title">
        <div class="flex flex-col gap-1">
            <h2 id="profil-title" class="hf-h2 text-foreground">@T("account.profileTitle")</h2>
            <p class="text-sm leading-snug text-muted-foreground">@T("account.profileDescription")</p>
        </div>
        <ProfileSection />
    </section>

    <section id="preferences" class="@CardClass" aria-labelledby="preferences-title">
        <h2 id="preferences-title" class="hf-h2 text-foreground">@T("settings.preferencesTitle")</h2>
        <div class="flex flex-wrap items-center justify-between gap-2.5">
            <span id="preferences-language" class="text-[15px] font-semibold text-foreground">@T("settings.language")</span>
            <LocaleSwitcher LabelId="preferences-language" Fragment="preferences" />
        </div>
        <div class="flex flex-wrap items-center justify-between gap-2.5">
            <span id="preferences-theme" class="text-[15px] font-semibold text-foreground">@T("settings.theme")</span>
            <ThemeToggle LabelId="preferences-theme" />
        </div>
    </section>

    <section id="donnees" class="@CardClass" aria-labelledby="donnees-title">
        <h2 id="donnees-title" class="hf-h2 text-foreground">@T("account.dataTitle")</h2>
        <DataSection />
    </section>

    <section id="api" class="@CardClass" aria-labelledby="api-title">
        <ApiKeysSection TitleId="api-title" />
    </section>

    <section id="applications" class="@CardClass" aria-labelledby="applications-title">
        <ConnectedAppsSection TitleId="applications-title" />
    </section>

    <section id="suppression" class="@CardClass border-destructive-border" aria-labelledby="suppression-title">
        <DeleteAccountSection />
    </section>

    @* Mobile only: the entries of the header avatar menu, which is hidden under 640 px. *@
    <ul class="hf-box sm:hidden" aria-label="@T("settings.menuLabel")">
        @if (IsAdmin)
        {
            <li class="border-b border-divider">
                <a href="@($"/{Locale}/admin")" class="@MobileRowClass text-foreground hover:bg-accent" data-testid="settings-admin-mobile">
                    <LucideIcon Name="shield-check" Size="18" Class="text-muted-foreground" />
                    <span class="flex-1">@T("nav.admin")</span>
                    <LucideIcon Name="chevron-right" Size="16" Class="text-muted-foreground" />
                </a>
            </li>
        }
        <li>
            <button type="button" class="@MobileRowClass w-full text-left text-late hover:bg-late-soft" data-testid="settings-logout-mobile" @onclick="Session.SignOutAsync">
                <LucideIcon Name="log-out" Size="18" />
                <span class="flex-1">@T("nav.logout")</span>
            </button>
        </li>
    </ul>
</div>

@code {
    [Parameter] public new string Locale { get; set; } = "fr";

    private static readonly string[] SectionIds = { "profil", "preferences", "donnees", "api", "applications", "suppression" };

    /// <summary>Section card: card, 1 px border, radius 16, padding 22, gap 16; clears the sticky header on anchor jumps.</summary>
    private const string CardClass = "hf-card flex scroll-mt-20 flex-col gap-4 p-[22px]";

    private const string MobileRowClass = "flex min-h-12 items-center gap-3 px-4 text-[15px] font-semibold no-underline";

    private string? _renderedLocale;
    private bool _scrollToHash;

    private bool IsAdmin => Tokens.User?.IsAdmin == true;

    protected override void OnParametersSet()
    {
        // First render, or the same page re-rendered in the other language (LocaleSwitcher keeps
        // #preferences): scroll to the #hash once rendered.
        if (_renderedLocale == Locale) return;
        _renderedLocale = Locale;
        _scrollToHash = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Opened on /settings#donnees: scroll there once the sections exist — the browser tried
        // before the WebAssembly render.
        if (!_scrollToHash) return;
        _scrollToHash = false;
        var hash = await JS.InvokeAsync<string>("hf.sections.hash");
        if (Array.IndexOf(SectionIds, hash) >= 0)
            await JS.InvokeAsync<bool>("hf.sections.scrollTo", hash, false);
    }
}
