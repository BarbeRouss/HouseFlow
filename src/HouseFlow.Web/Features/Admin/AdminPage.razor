@page "/{Locale}/admin"
@layout DashboardLayout
@inherits AppComponentBase
@inject ApiService Api
@inject TokenStore Tokens

@* P12 · Administration — functions unchanged, visual harmonisation only (tokens, C1, C6).
   Non-admin → P13 (403). Stats without the "Admins" counter (visible in the list). Search
   runs while typing, 300 ms after the last keystroke, no button. *@
@if (Tokens.User?.IsAdmin != true)
{
    <ErrorPage Code="403" TestId="admin-forbidden" />
}
else
{
    <div class="mx-auto flex w-full max-w-[580px] flex-col gap-4 px-4 py-6 sm:py-8">
        <h1 class="text-2xl font-semibold text-foreground">@T("admin.title")</h1>

        <AsyncSection TItem="AdminStats" Load="Api.GetAdminStatsAsync" HandleNotFound="false">
            <Loading>
                <div class="grid grid-cols-2 gap-2 sm:grid-cols-4" aria-hidden="true">
                    @for (var i = 0; i < 4; i++)
                    {
                        <div class="hf-box flex flex-col gap-2 p-2">
                            <Skeleton Width="60%" Height="9px" />
                            <Skeleton Width="40%" Height="18px" />
                        </div>
                    }
                </div>
            </Loading>
            <ChildContent Context="stats">
                <div class="grid grid-cols-2 gap-2 sm:grid-cols-4" data-testid="admin-stats">
                    @StatTile(T("admin.stats.users"), stats.Users)
                    @StatTile(T("admin.stats.houses"), stats.Houses)
                    @StatTile(T("admin.stats.devices"), stats.Devices)
                    @StatTile(T("admin.stats.maintenances"), stats.MaintenanceInstances)
                </div>
            </ChildContent>
        </AsyncSection>

        <input type="search" value="@_search" @oninput="OnSearchInput"
               placeholder="@T("admin.users.searchPlaceholder")" aria-label="@T("admin.users.searchPlaceholder")"
               class="hf-input" data-testid="admin-search" />

        <AsyncSection @ref="_usersSection" TItem="AdminUsersPage" Load="LoadUsers" HandleNotFound="false"
                      IsEmpty="p => p.Users.Count == 0">
            <Loading><SkeletonRows Count="4" /></Loading>
            <Empty>
                <div class="hf-box px-4 py-8 text-center">
                    <p class="text-sm font-medium text-foreground">@T("admin.users.noResults")</p>
                    <p class="mt-1 text-sm text-muted-foreground">@T("admin.users.noResultsDescription")</p>
                </div>
            </Empty>
            <ChildContent Context="page">
                <div class="hf-box" data-testid="admin-users">
                    @foreach (var user in page.Users)
                    {
                        var isSelf = user.Id == Tokens.User?.Id;
                        var name = $"{user.FirstName} {user.LastName}".Trim();
                        <div class="hf-row" data-testid="admin-user-row" data-email="@user.Email">
                            <Avatar Name="@name" Size="32" Decorative="true" />
                            <div class="min-w-0 flex-1">
                                <p class="truncate text-sm font-medium text-foreground">
                                    @name
                                    @if (isSelf)
                                    {
                                        <span class="text-muted-foreground"> (@T("admin.users.you"))</span>
                                    }
                                </p>
                                <p class="truncate text-[13px] text-muted-foreground">
                                    @user.Email · @T("admin.users.houses", new { count = user.HousesCount })
                                </p>
                            </div>
                            <div class="flex shrink-0 items-center gap-2">
                                @if (user.IsAdmin)
                                {
                                    <span class="rounded border border-primary px-1.5 py-0.5 text-[11px] font-semibold uppercase tracking-wide text-primary-strong" data-testid="admin-badge">
                                        @T("admin.users.roleAdmin")
                                    </span>
                                }
                                @if (!isSelf)
                                {
                                    <button type="button" class="hf-btn hf-btn-outline hf-btn-sm" @onclick="() => AskToggle(user)">
                                        @(user.IsAdmin ? T("admin.users.revoke") : T("admin.users.grant"))
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>

                @if (TotalPages(page) > 1)
                {
                    <div class="mt-3 flex items-center justify-between text-sm text-muted-foreground">
                        <button type="button" class="hf-btn hf-btn-outline hf-btn-sm" @onclick="() => GoTo(page.Page - 1)" disabled="@(page.Page <= 1)">
                            @T("common.previous")
                        </button>
                        <span>@T("admin.users.pageOf", new { page = page.Page, pages = TotalPages(page) })</span>
                        <button type="button" class="hf-btn hf-btn-outline hf-btn-sm" @onclick="() => GoTo(page.Page + 1)" disabled="@(page.Page >= TotalPages(page))">
                            @T("common.next")
                        </button>
                    </div>
                }
            </ChildContent>
        </AsyncSection>
    </div>

    @if (_pending is { } target)
    {
        var targetName = $"{target.FirstName} {target.LastName}".Trim();
        <ConfirmDialog Open="true" OnClose="CloseDialog"
                       Title="@(target.IsAdmin ? T("admin.users.revokeTitle") : T("admin.users.grantTitle"))"
                       Message="@(target.IsAdmin ? T("admin.users.revokeConfirm", new { name = targetName }) : T("admin.users.grantConfirm", new { name = targetName }))"
                       ConfirmLabel="@T("admin.users.confirm")" Destructive="target.IsAdmin"
                       OnConfirm="ConfirmToggle" Error="@_toggleError" />
    }
}

@code {
    [Parameter] public new string Locale { get; set; } = "fr";

    private const int PageSize = 20;
    private const int SearchDebounceMs = 300;

    private AsyncSection<AdminUsersPage>? _usersSection;
    private AdminUser? _pending;
    private string? _toggleError;
    private string _search = "";
    private string _appliedSearch = "";
    private int _pageNo = 1;
    private CancellationTokenSource? _debounce;

    private RenderFragment StatTile(string label, int value) => __builder =>
    {
        <div class="hf-box p-2">
            <p class="truncate text-[13px] text-muted-foreground">@label</p>
            <p class="text-xl font-semibold text-foreground" data-testid="stat-value">@value.ToString("#,0", DateFormatter.Culture(Locale))</p>
        </div>
    };

    private Task<AdminUsersPage> LoadUsers() => Api.GetAdminUsersAsync(_appliedSearch, _pageNo, PageSize);

    private static int TotalPages(AdminUsersPage page) =>
        page.PageSize <= 0 ? 0 : (int)Math.Ceiling(page.Total / (double)page.PageSize);

    /// <summary>Search while typing: reload 300 ms after the last keystroke (previous wait cancelled).</summary>
    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _debounce?.Cancel();
        _debounce?.Dispose();
        var cts = _debounce = new CancellationTokenSource();
        try
        {
            await Task.Delay(SearchDebounceMs, cts.Token);
        }
        catch (TaskCanceledException)
        {
            return; // A newer keystroke restarted the wait.
        }

        var term = _search.Trim();
        if (term == _appliedSearch) return;
        _appliedSearch = term;
        _pageNo = 1;
        if (_usersSection is not null) await _usersSection.ReloadAsync();
    }

    private async Task GoTo(int page)
    {
        _pageNo = page;
        if (_usersSection is not null) await _usersSection.ReloadAsync();
    }

    private void AskToggle(AdminUser user)
    {
        _toggleError = null;
        _pending = user;
    }

    private void CloseDialog()
    {
        _pending = null;
        _toggleError = null;
    }

    private async Task ConfirmToggle()
    {
        if (_pending is not { } target) return;
        _toggleError = null;
        try
        {
            var updated = await Api.SetUserAdminAsync(target.Id, !target.IsAdmin);
            target.IsAdmin = updated.IsAdmin;
            _pending = null;
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or TaskCanceledException)
        {
            // The dialog stays open with the error (M6 convention).
            _toggleError = T("common.unexpectedError");
        }
    }

    public override void Dispose()
    {
        _debounce?.Cancel();
        _debounce?.Dispose();
        base.Dispose();
    }
}
