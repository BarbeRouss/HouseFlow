@inherits AppComponentBase
@inject ApiService Api
@inject TokenStore Tokens
@inject ToastService Toasts
@inject IJSRuntime JS
@inject NavigationManager Nav

@*
  M5 · Membres — opened from P09 (⋯ « Membres » or the avatars) when capabilities.canInviteTenants.
  Owner (CanManageMembers): members first without action for the owner; others get a role selector
  (saved at once) and ✕ (→ M6 « Retirer {nom} ? »); invite with email + role (+ role description).
  RW collaborator (restricted mode, R5): member list read-only (role as text), invite a tenant only
  (role fixed to Locataire); the API lists only tenant invitations to them.
  Pending invitations: « Renvoyer » (new link, expiry reset) and a menu with « Copier le lien » /
  « Annuler l'invitation ».
  No email is sent (decision 12): after creating or renewing an invitation the link is shown to copy.
  OnChanged: members changed (P09 refreshes its avatars).
*@
<Modal Open="Open" OnClose="Close" TestId="members-modal" MaxWidth="sm:max-w-lg"
       Title="@T("members.title", new { house = HouseName })" CancelLabel="@T("common.close")"
       PrimaryLabel="@T("members.createInvitation")" PrimaryTestId="invite-submit"
       SubmitDisabled="@(!EmailValid)" Busy="_inviting" Error="@_error" OnSubmit="InviteAsync"
       InitialFocus="#invite-email">
    <AsyncSection @ref="_section" TItem="MembersData" Load="LoadAsync" HandleNotFound="false">
        <Loading><SkeletonRows Count="2" /></Loading>
        <ChildContent Context="data">
            <div class="hf-box" data-testid="members-list">
                @foreach (var member in data.Members)
                {
                    var name = FullName(member);
                    <div class="hf-row" data-testid="member-row" data-role="@member.Role" @key="member.Id">
                        <Avatar Name="@name" Size="28" Decorative="true" />
                        <div class="flex min-w-0 flex-1 flex-col">
                            <span class="truncate text-sm text-foreground">@(member.UserId == Tokens.User?.Id ? T("members.you", new { name }) : name)</span>
                            <span class="truncate text-xs text-muted-foreground">@member.Email</span>
                        </div>
                        @if (member.Role == HouseRoles.Owner)
                        {
                            <span class="whitespace-nowrap text-sm text-muted-foreground">@T("houses.owner")</span>
                        }
                        else if (!CanManageMembers)
                        {
                            <span class="whitespace-nowrap text-sm text-muted-foreground" data-testid="member-role-label">@T(HouseRow.RoleKey(member.Role))</span>
                        }
                        else
                        {
                            <select class="hf-input h-9 w-auto max-w-[9.5rem] py-1 text-sm" aria-label="@T("members.roleOf", new { name })"
                                    data-testid="member-role" value="@member.Role" @onchange="e => ChangeRoleAsync(member, e.Value?.ToString())">
                                @foreach (var role in InvitableRoles)
                                {
                                    <option value="@role">@T(HouseRow.RoleKey(role))</option>
                                }
                            </select>
                            <button type="button" class="hf-btn hf-btn-outline hf-btn-icon hf-btn-sm"
                                    aria-label="@T("members.removeAria", new { name })" data-testid="member-remove"
                                    @onclick="() => AskRemove(member)">
                                <LucideIcon Name="x" Class="h-4 w-4" />
                            </button>
                        }
                    </div>
                }
                @foreach (var invitation in data.Invitations)
                {
                    <div class="hf-row" data-testid="invitation-row" data-email="@invitation.Email" @key="invitation.Id">
                        <span class="inline-flex h-7 w-7 shrink-0 rounded-full border border-dashed border-muted-foreground" aria-hidden="true"></span>
                        <div class="flex min-w-0 flex-1 flex-col">
                            <span class="truncate text-sm text-foreground">@(invitation.Email ?? T(HouseRow.RoleKey(invitation.Role)))</span>
                            <span class="text-xs text-muted-foreground">
                                @(invitation.IsExpired ? T("members.invitationExpired") : T("members.invitationPending")) · @T(HouseRow.RoleKey(invitation.Role))
                            </span>
                        </div>
                        <button type="button" class="hf-btn hf-btn-ghost hf-btn-sm" data-testid="invitation-resend"
                                disabled="@(_rowBusy == invitation.Id)" @onclick="() => ResendAsync(invitation)">
                            <BusyLabel Busy="@(_rowBusy == invitation.Id)">@T("members.resend")</BusyLabel>
                        </button>
                        <OverflowMenu AriaLabel="@T("members.invitationActions")" TestId="invitation-menu">
                            <MenuItem IconName="copy" OnClick="() => CopyAsync(invitation.Token)" TestId="invitation-copy">@T("members.copyLink")</MenuItem>
                            <MenuItem IconName="x" Destructive="true" OnClick="() => CancelInvitationAsync(invitation)" TestId="invitation-cancel">@T("members.cancelInvitation")</MenuItem>
                        </OverflowMenu>
                    </div>
                }
            </div>
        </ChildContent>
    </AsyncSection>

    @if (_link is { } link)
    {
        <div class="flex flex-col gap-1.5 rounded-md border border-border bg-background p-3" data-testid="invitation-link-box">
            <label class="text-sm font-medium text-foreground" for="invitation-link">@T("members.linkTitle", new { email = link.Email })</label>
            <div class="flex gap-2">
                <input id="invitation-link" class="hf-input min-w-0 flex-1 text-sm" readonly value="@link.Url" data-testid="invitation-link" />
                <button type="button" class="hf-btn hf-btn-outline" data-testid="invitation-link-copy" @onclick="() => CopyUrlAsync(link.Url)">
                    <LucideIcon Name="@(_copied ? "check" : "copy")" Class="h-4 w-4" />
                    @(_copied ? T("members.linkCopied") : T("members.copyLink"))
                </button>
            </div>
            <p class="text-xs text-muted-foreground">@T("members.linkHint")</p>
        </div>
    }

    <div class="flex flex-col gap-2">
        <span class="text-sm text-muted-foreground">@T("members.inviteLabel")</span>
        <div class="flex gap-2">
            <input id="invite-email" type="email" class="hf-input min-w-0 flex-1" placeholder="@T("members.emailPlaceholder")"
                   aria-label="@T("members.emailLabel")" autocomplete="off" maxlength="255" data-testid="invite-email"
                   @bind="_email" @bind:event="oninput" />
            @if (CanManageMembers)
            {
                <select class="hf-input w-auto max-w-[10rem]" aria-label="@T("members.roleLabel")" data-testid="invite-role" @bind="_role">
                    @foreach (var role in InvitableRoles)
                    {
                        <option value="@role">@T(HouseRow.RoleKey(role))</option>
                    }
                </select>
            }
            else
            {
                <span class="inline-flex items-center whitespace-nowrap px-1 text-sm text-foreground" data-testid="invite-role-fixed">@T(HouseRow.RoleKey(HouseRoles.Tenant))</span>
            }
        </div>
        <p class="text-[12.5px] text-muted-foreground" data-testid="invite-role-description">@T($"members.roleDescriptions.{_role}")</p>
    </div>
</Modal>

<ConfirmDialog Open="_removing is not null" OnClose="() => _removing = null" TestId="remove-member-dialog"
               Title="@T("members.removeTitle", new { name = RemovingName })"
               Message="@T("members.removeMessage", new { name = RemovingName })"
               ConfirmLabel="@T("members.removeConfirm")" OnConfirm="RemoveAsync" Error="@_removeError" />

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter, EditorRequired] public string HouseId { get; set; } = "";
    [Parameter] public string HouseName { get; set; } = "";

    /// <summary>Owner (capabilities.canManageMembers). False: RW restricted mode — read-only members, tenant invitations only.</summary>
    [Parameter] public bool CanManageMembers { get; set; }

    /// <summary>Raised after a member's role changed or a member was removed.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private static readonly string[] InvitableRoles = { HouseRoles.CollaboratorRW, HouseRoles.CollaboratorRO, HouseRoles.Tenant };
    private static readonly System.Text.RegularExpressions.Regex EmailPattern =
        new(@"^[^@\s]+@[^@\s]+\.[^@\s]+$", System.Text.RegularExpressions.RegexOptions.Compiled);

    private sealed record MembersData(List<HouseMember> Members, List<Invitation> Invitations);
    private sealed record ShownLink(string Email, string Url);

    private AsyncSection<MembersData>? _section;
    private string _email = "";
    private string _role = HouseRoles.CollaboratorRW;
    private bool _inviting;
    private string? _error;
    private ShownLink? _link;
    private bool _copied;
    private string? _rowBusy;
    private HouseMember? _removing;
    private string? _removeError;
    private bool _wasOpen;

    private string DefaultRole => CanManageMembers ? HouseRoles.CollaboratorRW : HouseRoles.Tenant;

    private bool EmailValid => EmailPattern.IsMatch(_email.Trim());
    private string RemovingName => _removing is null ? "" : FullName(_removing);

    protected override void OnParametersSet()
    {
        if (Open && !_wasOpen)
        {
            _email = "";
            _role = DefaultRole;
            _error = null;
            _link = null;
            _copied = false;
        }
        _wasOpen = Open;
    }

    private async Task<MembersData> LoadAsync()
    {
        var members = Api.GetMembersAsync(HouseId);
        var invitations = Api.GetInvitationsAsync(HouseId);
        await Task.WhenAll(members, invitations);
        return new MembersData(members.Result, invitations.Result);
    }

    private Task Close() => OnClose.InvokeAsync();

    private static string FullName(HouseMember m) => $"{m.FirstName} {m.LastName}".Trim();

    private string LinkFor(string token) =>
        $"{new Uri(Nav.Uri).GetLeftPart(UriPartial.Authority)}/{Locale}/invitations/{token}";

    private async Task InviteAsync()
    {
        if (!EmailValid || _inviting) return;
        _inviting = true;
        _error = null;
        var email = _email.Trim();
        try
        {
            var invitation = await Api.CreateInvitationAsync(HouseId, new CreateInvitationRequest { Email = email, Role = CanManageMembers ? _role : HouseRoles.Tenant });
            ShowLink(invitation.Email ?? email, invitation.Token);
            _email = "";
            Toasts.Show(T("members.invitationCreated", new { email = invitation.Email ?? email }));
            await ReloadAsync();
        }
        catch (ApiException ex)
        {
            _error = ex.Code switch
            {
                ApiErrorCodes.InvitationAlreadyPending => T("members.errors.alreadyPending"),
                ApiErrorCodes.InvitationLimitReached => T("members.errors.limitReached"),
                ApiErrorCodes.AlreadyMember => T("members.errors.alreadyMember"),
                _ => T("members.errors.generic"),
            };
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            _error = T("members.errors.generic");
        }
        finally
        {
            _inviting = false;
        }
    }

    private async Task ResendAsync(Invitation invitation)
    {
        _rowBusy = invitation.Id;
        _error = null;
        try
        {
            var renewed = await Api.ResendInvitationAsync(invitation.Id);
            var email = renewed.Email ?? invitation.Email ?? "";
            ShowLink(email, renewed.Token);
            Toasts.Show(T("members.invitationRenewed", new { email }));
            await ReloadAsync();
        }
        catch (ApiException ex) when (ex.Code == ApiErrorCodes.InvitationAlreadyPending)
        {
            // Another pending invitation exists for the same email.
            _error = T("members.errors.alreadyPending");
        }
        catch (ApiException ex) when (ex.Code == ApiErrorCodes.InvitationLimitReached)
        {
            // Re-activating this expired invitation would exceed the 20 pending invitations per house.
            _error = T("members.errors.limitReached");
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or TaskCanceledException)
        {
            _error = T("members.errors.generic");
        }
        finally
        {
            _rowBusy = null;
        }
    }

    private async Task CancelInvitationAsync(Invitation invitation)
    {
        _error = null;
        try
        {
            await Api.RevokeInvitationAsync(invitation.Id);
            if (_link is not null && _link.Url.EndsWith("/" + invitation.Token, StringComparison.Ordinal)) _link = null;
            Toasts.Show(T("members.invitationCancelled"));
            await ReloadAsync();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or TaskCanceledException)
        {
            _error = T("members.errors.generic");
        }
    }

    private async Task ChangeRoleAsync(HouseMember member, string? role)
    {
        if (string.IsNullOrEmpty(role) || role == member.Role) return;
        _error = null;
        try
        {
            await Api.UpdateMemberRoleAsync(member.Id, role);
            member.Role = role;
            Toasts.Show(T("toast.changesSaved"));
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or TaskCanceledException)
        {
            _error = T("members.errors.generic");
            await ReloadAsync(); // put the selector back on the stored role
        }
    }

    private void AskRemove(HouseMember member)
    {
        _removeError = null;
        _removing = member;
    }

    private async Task RemoveAsync()
    {
        if (_removing is not { } member) return;
        try
        {
            await Api.RemoveMemberAsync(member.Id);
            var name = FullName(member);
            _removing = null;
            Toasts.Show(T("members.removed", new { name }));
            await ReloadAsync();
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or TaskCanceledException)
        {
            _removeError = T("members.errors.generic");
        }
    }

    private void ShowLink(string email, string token)
    {
        _link = new ShownLink(email, LinkFor(token));
        _copied = false;
    }

    private Task ReloadAsync() => _section?.ReloadAsync() ?? Task.CompletedTask;

    private async Task CopyAsync(string token)
    {
        await JS.InvokeVoidAsync("hf.copyToClipboard", LinkFor(token));
        Toasts.Show(T("members.linkCopied"));
    }

    private async Task CopyUrlAsync(string url)
    {
        await JS.InvokeVoidAsync("hf.copyToClipboard", url);
        _copied = true;
    }
}
