@page "/{Locale}/houses/{HouseId}"
@layout DashboardLayout
@inherits AppComponentBase
@inject ApiService Api
@inject NavigationManager Nav

<div class="min-h-screen bg-gradient-to-br from-slate-50 via-blue-50/30 to-slate-50 dark:from-gray-900 dark:via-gray-900 dark:to-gray-900 p-4 sm:p-8">
    <div class="max-w-7xl mx-auto">
        @if (_loading)
        {
            <p class="text-gray-500">@T("common.loading")</p>
        }
        else if (_house is null)
        {
            <div class="p-8">@T("houses.notFound")</div>
        }
        else
        {
            <Breadcrumb Items="@(new[] { new Breadcrumb.Crumb(_house.Name) })" />

            <div class="mb-8 rounded-xl border border-white/50 bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm shadow-sm">
                <div class="p-6 sm:p-8">
                    <div class="flex flex-col lg:flex-row lg:items-center gap-6">
                        <div class="flex items-start gap-4 flex-1">
                            <div class="w-16 h-16 bg-gradient-to-br from-blue-100 to-blue-200 dark:from-blue-900/30 dark:to-blue-800/30 rounded-2xl flex items-center justify-center shadow-sm flex-shrink-0">
                                <LucideIcon Name="house" Class="h-8 w-8 text-blue-600 dark:text-blue-400" />
                            </div>
                            <div class="flex-1">
                                <h1 class="text-2xl font-extrabold text-gray-900 dark:text-white mb-1">@_house.Name</h1>
                                @if (!string.IsNullOrEmpty(_house.Address) || !string.IsNullOrEmpty(_house.City) || !string.IsNullOrEmpty(_house.ZipCode))
                                {
                                    <p class="text-gray-500 dark:text-gray-400 mb-3">
                                        @string.Join(", ", new[] { _house.Address, _house.City, _house.ZipCode }.Where(s => !string.IsNullOrEmpty(s)))
                                    </p>
                                }
                                @if (_totalDevices > 0)
                                {
                                    <div class="max-w-md">
                                        <div class="flex justify-between text-sm mb-2">
                                            <span class="text-gray-500 dark:text-gray-400">@T("houses.progression")</span>
                                            <span class="font-semibold @ScoreText">@T("houses.xOutOfYUpToDate", new { x = _upToDate, y = _totalDevices })</span>
                                        </div>
                                        <div class="h-3 bg-gray-100 dark:bg-gray-700 rounded-full overflow-hidden">
                                            <div class="h-full rounded-full transition-all duration-500 @ScoreBar" style="width:@(_house.Score)%"></div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="flex items-center gap-6">
                            <div class="hidden sm:block"><ScoreRing Score="_house.Score" Size="lg" /></div>
                            <div class="flex items-center gap-2">
                                @if (_isOwner)
                                {
                                    <button type="button" @onclick="() => _showEdit = true" title="@T("houses.editHouse")"
                                            class="inline-flex h-9 w-9 items-center justify-center rounded-md hover:bg-gray-100 dark:hover:bg-gray-700">
                                        <LucideIcon Name="pencil" Class="h-4 w-4" />
                                    </button>
                                    <button type="button" @onclick="() => _showDelete = true" title="@T("houses.deleteHouse")"
                                            class="inline-flex h-9 w-9 items-center justify-center rounded-md text-red-600 hover:text-red-700 hover:bg-red-50 dark:hover:bg-red-900/20">
                                        <LucideIcon Name="trash-2" Class="h-4 w-4" />
                                    </button>
                                }
                                @if (!_isOwner)
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300">@T("houses.shared")</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
                <h2 class="text-xl font-bold text-gray-900 dark:text-white">@T("devices.title")</h2>
                @if (_canEdit)
                {
                    <a href="/@Locale/houses/@HouseId/devices/new" role="button"
                       class="inline-flex items-center rounded-lg bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 shadow-lg shadow-blue-500/30 px-4 py-2 text-sm font-medium text-white">
                        <LucideIcon Name="plus" Class="h-5 w-5 mr-2" /> @T("devices.addDevice")
                    </a>
                }
            </div>

            @if (_sortedDevices.Count == 0)
            {
                <EmptyState IconName="cpu" Title="@T("devices.noDevicesYet")" Description="@T("devices.noDevicesDescription")">
                    <Action>
                        @if (_canEdit)
                        {
                            <a href="/@Locale/houses/@HouseId/devices/new" role="button" class="inline-flex items-center rounded-lg bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 shadow-lg shadow-blue-500/30 px-4 py-2 text-sm font-medium text-white">
                                <LucideIcon Name="plus" Class="h-5 w-5 mr-2" /> @T("devices.addDevice")
                            </a>
                        }
                    </Action>
                </EmptyState>
            }
            else
            {
                <div class="space-y-4">
                    @foreach (var device in _sortedDevices)
                    {
                        var isOverdue = device.OverdueCount > 0;
                        var isPending = device.PendingCount > 0 && !isOverdue;
                        <a href="/@Locale/devices/@device.Id" class="group relative block rounded-xl border bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm transition-all hover:shadow-lg hover:-translate-y-0.5 @DeviceBorder(isOverdue, isPending)">
                            @if (isOverdue)
                            {
                                <div class="absolute top-0 right-0 bg-red-500 text-white text-xs font-bold px-3 py-1 rounded-bl-xl rounded-tr-lg">@T("houses.overdueBanner")</div>
                            }
                            <div class="p-5">
                                <div class="flex items-center gap-4">
                                    <div class="w-14 h-14 rounded-xl flex items-center justify-center flex-shrink-0 @DeviceIconBg(isOverdue, isPending)">
                                        <span class="text-2xl">@DeviceEmoji(device.Type)</span>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <div class="flex items-center gap-2 mb-1">
                                            <h3 class="font-bold text-gray-900 dark:text-white">@device.Name</h3>
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold @DeviceBadge(isOverdue, isPending)">
                                                @if (isOverdue)
                                                {
                                                    <LucideIcon Name="triangle-alert" Class="h-3 w-3" />@T("maintenance.overdue")
                                                }
                                                else if (isPending)
                                                {
                                                    <LucideIcon Name="clock" Class="h-3 w-3" />@($"{device.PendingCount} {T("maintenance.pending")}")
                                                }
                                                else
                                                {
                                                    <LucideIcon Name="check" Class="h-3 w-3" />@T("maintenance.upToDate")
                                                }
                                            </span>
                                        </div>
                                        <p class="text-sm text-gray-500 dark:text-gray-400 truncate">@device.Type</p>
                                        <div class="mt-2 flex items-center gap-3">
                                            <div class="flex-1 max-w-[200px] h-1.5 bg-gray-100 dark:bg-gray-700 rounded-full overflow-hidden">
                                                <div class="h-full rounded-full @DeviceBar(isOverdue, isPending)" style="width:@(device.Score)%"></div>
                                            </div>
                                            <span class="text-xs text-gray-500 dark:text-gray-400">@(device.Score)%</span>
                                        </div>
                                    </div>
                                    <div class="w-10 h-10 rounded-full bg-gray-100 dark:bg-gray-700 flex items-center justify-center group-hover:bg-blue-100 dark:group-hover:bg-blue-900/30 transition">
                                        <LucideIcon Name="chevron-right" Class="h-5 w-5 text-gray-400" />
                                    </div>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            }

            @if (_canEdit)
            {
                <div class="mt-8">
                    <MembersSection HouseId="@HouseId" UserRole="@_userRole" />
                </div>
            }
        }
    </div>
</div>

@if (_house is not null)
{
    <Modal Open="_showEdit" OnClose="() => _showEdit = false">
        <div class="p-6">
            <h2 class="text-lg font-bold text-gray-900 dark:text-white mb-4">@T("houses.editHouse")</h2>
            <form @onsubmit="SaveEdit" @onsubmit:preventDefault="true" class="space-y-4">
                <input @bind="_editName" @bind:event="oninput" placeholder="@T("houses.houseName")" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md dark:bg-gray-700 dark:text-white" />
                <input @bind="_editAddress" @bind:event="oninput" placeholder="@T("houses.address")" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md dark:bg-gray-700 dark:text-white" />
                <div class="grid grid-cols-2 gap-3">
                    <input @bind="_editZip" @bind:event="oninput" placeholder="@T("houses.zipCode")" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md dark:bg-gray-700 dark:text-white" />
                    <input @bind="_editCity" @bind:event="oninput" placeholder="@T("houses.city")" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md dark:bg-gray-700 dark:text-white" />
                </div>
                <div class="flex gap-3">
                    <button type="button" @onclick="() => _showEdit = false" class="flex-1 rounded-md border border-gray-300 dark:border-gray-600 px-4 py-2 text-sm">@T("common.cancel")</button>
                    <button type="submit" class="flex-1 rounded-md bg-primary px-4 py-2 text-sm text-white">@T("common.save")</button>
                </div>
            </form>
        </div>
    </Modal>

    <Modal Open="_showDelete" OnClose="() => _showDelete = false">
        <div class="p-6">
            <h2 class="text-lg font-bold text-gray-900 dark:text-white mb-2">@T("houses.deleteHouse")</h2>
            <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">@T("houses.deleteConfirmation", new { name = _house.Name })</p>
            <div class="flex gap-3">
                <button type="button" @onclick="() => _showDelete = false" class="flex-1 rounded-md border border-gray-300 dark:border-gray-600 px-4 py-2 text-sm">@T("common.cancel")</button>
                <button type="button" @onclick="ConfirmDelete" class="flex-1 rounded-md bg-red-600 px-4 py-2 text-sm text-white">@T("common.delete")</button>
            </div>
        </div>
    </Modal>
}

@code {
    [Parameter] public string Locale { get; set; } = "fr";
    [Parameter] public string HouseId { get; set; } = "";

    private bool _loading = true;
    private HouseDetail? _house;
    private List<DeviceSummary> _sortedDevices = new();
    private string _userRole = "CollaboratorRO";
    private bool _isOwner;
    private bool _canEdit;
    private int _upToDate;
    private int _totalDevices;

    private bool _showEdit, _showDelete;
    private string _editName = "", _editAddress = "", _editZip = "", _editCity = "";

    protected override async Task OnParametersSetAsync()
    {
        base.OnInitialized();
        await Load();
    }

    private async Task Load()
    {
        _loading = true;
        try
        {
            _house = await Api.GetHouseAsync(HouseId);
            _userRole = string.IsNullOrEmpty(_house.UserRole) ? "CollaboratorRO" : _house.UserRole;
            _isOwner = _userRole == "Owner";
            _canEdit = _isOwner || _userRole == "CollaboratorRW";
            _totalDevices = _house.Devices.Count;
            _upToDate = _house.Devices.Count(d => d.Score == 100);
            _sortedDevices = _house.Devices
                .OrderBy(d => d.OverdueCount > 0 ? 0 : d.PendingCount > 0 ? 1 : 2)
                .ThenBy(d => d.Score)
                .ToList();
            _editName = _house.Name; _editAddress = _house.Address ?? "";
            _editZip = _house.ZipCode ?? ""; _editCity = _house.City ?? "";
        }
        catch { _house = null; }
        finally { _loading = false; }
    }

    private async Task SaveEdit()
    {
        await Api.UpdateHouseAsync(HouseId, new CreateHouseRequest
        {
            Name = _editName,
            Address = string.IsNullOrWhiteSpace(_editAddress) ? null : _editAddress,
            ZipCode = string.IsNullOrWhiteSpace(_editZip) ? null : _editZip,
            City = string.IsNullOrWhiteSpace(_editCity) ? null : _editCity,
        });
        _showEdit = false;
        await Load();
    }

    private async Task ConfirmDelete()
    {
        await Api.DeleteHouseAsync(HouseId);
        Nav.NavigateTo($"/{Locale}/dashboard");
    }

    private string ScoreText => _house is null ? "" : _house.Score >= 80 ? "text-green-600" : _house.Score >= 50 ? "text-orange-600" : "text-red-600";
    private string ScoreBar => _house is null ? "" : _house.Score >= 80 ? "bg-gradient-to-r from-green-400 to-emerald-500" : _house.Score >= 50 ? "bg-gradient-to-r from-orange-400 to-orange-500" : "bg-gradient-to-r from-red-400 to-rose-500";

    private static string DeviceBorder(bool o, bool p) => o ? "border-red-200 dark:border-red-800" : p ? "border-orange-200 dark:border-orange-800" : "border-green-100 dark:border-green-900";
    private static string DeviceIconBg(bool o, bool p) => o ? "bg-gradient-to-br from-red-100 to-red-200 dark:from-red-900/30 dark:to-red-800/30" : p ? "bg-gradient-to-br from-orange-100 to-orange-200 dark:from-orange-900/30 dark:to-orange-800/30" : "bg-gradient-to-br from-green-100 to-emerald-200 dark:from-green-900/30 dark:to-green-800/30";
    private static string DeviceBadge(bool o, bool p) => o ? "bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300" : p ? "bg-orange-100 dark:bg-orange-900/30 text-orange-700 dark:text-orange-300" : "bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300";
    private static string DeviceBar(bool o, bool p) => o ? "bg-gradient-to-r from-red-400 to-red-500" : p ? "bg-gradient-to-r from-orange-400 to-orange-500" : "bg-gradient-to-r from-green-400 to-emerald-500";

    private static string DeviceEmoji(string type) => type switch
    {
        "Chaudière Gaz" or "Chaudière Fioul" => "🔥",
        "Pompe à Chaleur" or "Climatisation" => "❄️",
        "Poêle à Bois" => "🪵",
        "Toiture" => "🏠",
        "Détecteur de Fumée" or "Alarme" => "🚨",
        "Chauffe-eau" => "🚿",
        "VMC" => "💨",
        _ => "🔧",
    };
}
