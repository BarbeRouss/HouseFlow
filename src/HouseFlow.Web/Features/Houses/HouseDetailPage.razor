@page "/{Locale}/houses/{HouseId}"
@layout DashboardLayout
@inherits AppComponentBase
@using HouseFlow.Web.Features.Devices
@inject ApiService Api
@inject NavigationManager Nav
@inject ToastService Toasts
@inject NavCounterService NavCounter

@*
  P09 · Maison. Breadcrumb « Maisons / [house selector ▾] »; header: name, address (hidden if empty),
  « à jour » ring, member avatars (→ M5 for the owner), ⋯ (owner: Modifier → M1, Membres → M5,
  Supprimer → M6 then P08 + toast). Devices: C4 rows sorted by status then due date, « Ajouter un
  appareil » (R5: owner + RW) → M2 then P10. 404/403 → P13 (AsyncSection).
*@
<div class="mx-auto flex w-full max-w-[580px] flex-col gap-4 px-4 py-6 sm:py-8" data-testid="house-page">
    <AsyncSection @ref="_section" TItem="HouseDetail" Load="() => Api.GetHouseAsync(HouseId)" Key="HouseId"
                  OnLoaded="OnHouseLoaded">
        <Loading>
            <div class="flex h-8 items-center gap-2 border-b border-dashed border-border" aria-hidden="true">
                <Skeleton Width="120px" Height="12px" />
            </div>
            <SkeletonHeader Class="mt-4" />
            <SkeletonRows Class="mt-6" />
        </Loading>
        <ChildContent Context="house">
            @* ---- breadcrumb ---- *@
            <nav class="flex min-h-8 items-center gap-1.5 border-b border-dashed border-border pb-1 text-sm text-muted-foreground"
                 aria-label="@T("houses.breadcrumb")" data-testid="breadcrumb">
                <a href="/@Locale/houses" class="inline-flex items-center hover:text-foreground hover:underline max-sm:min-h-11" data-testid="breadcrumb-houses">@T("houses.title")</a>
                <span aria-hidden="true">/</span>
                <HouseSelector HouseId="@house.Id" HouseName="@house.Name" />
            </nav>

            @* ---- header ---- *@
            <div class="flex items-start justify-between gap-3">
                <div class="flex min-w-0 flex-col gap-1">
                    <h1 class="break-words text-2xl font-semibold text-foreground" data-testid="house-name">@house.Name</h1>
                    @if (FullAddress(house) is { Length: > 0 } address)
                    {
                        <p class="text-sm text-muted-foreground" data-testid="house-address">@address</p>
                    }
                    @if (!string.IsNullOrEmpty(house.UserRole) && house.UserRole != HouseRoles.Owner)
                    {
                        <p class="text-sm text-muted-foreground" data-testid="house-shared">@T("houses.sharedAs", new { role = T(HouseRow.RoleKey(house.UserRole)) })</p>
                    }
                </div>
                <div class="flex shrink-0 items-center gap-2.5">
                    @if (house.MaintenanceTypesCount > 0)
                    {
                        <ProgressRing UpToDate="house.UpToDateCount" Total="house.MaintenanceTypesCount" ShowLabel="false" />
                    }
                    @if (_memberNames is { Count: > 0 } names)
                    {
                        @if (house.Capabilities.CanInviteTenants)
                        {
                            <button type="button" class="rounded-full focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring"
                                    aria-label="@T("houses.membersButton")" data-testid="members-avatars" @onclick="() => _membersOpen = true">
                                <AvatarStack Names="names" Size="24" />
                            </button>
                        }
                        else
                        {
                            <AvatarStack Names="names" Size="24" />
                        }
                    }
                    @if (house.Capabilities.CanManageHouse || house.Capabilities.CanInviteTenants)
                    {
                        <OverflowMenu TestId="house-menu" Small="false">
                            @if (house.Capabilities.CanManageHouse)
                            {
                                <MenuItem IconName="pencil" OnClick="() => _editOpen = true" TestId="house-menu-edit">@T("houses.menuEdit")</MenuItem>
                            }
                            @if (house.Capabilities.CanInviteTenants)
                            {
                                <MenuItem IconName="users" OnClick="() => _membersOpen = true" TestId="house-menu-members">@T("houses.menuMembers")</MenuItem>
                            }
                            @if (house.Capabilities.CanManageHouse)
                            {
                                <MenuItem IconName="trash-2" Destructive="true" OnClick="AskDelete" TestId="house-menu-delete">@T("houses.menuDelete")</MenuItem>
                            }
                        </OverflowMenu>
                    }
                </div>
            </div>

            @* ---- devices ---- *@
            <div class="mt-2 flex items-center justify-between gap-3">
                <h2 class="text-lg font-semibold text-foreground">@T("devices.title")</h2>
                @if (house.Capabilities.CanEditDevices && house.Devices.Count > 0)
                {
                    <button type="button" class="hf-btn hf-btn-outline hf-btn-sm" data-testid="add-device" @onclick="() => _addDeviceOpen = true">
                        @T("devices.add")
                    </button>
                }
            </div>
            @if (house.Devices.Count == 0)
            {
                <div class="hf-box flex flex-col items-center gap-3 px-5 py-10 text-center" data-testid="devices-empty">
                    <p class="text-sm text-foreground">@T("devices.empty")</p>
                    @if (house.Capabilities.CanEditDevices)
                    {
                        <button type="button" class="hf-btn hf-btn-primary" data-testid="add-device" @onclick="() => _addDeviceOpen = true">
                            @T("devices.add")
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="hf-box" data-testid="devices-list">
                    @foreach (var device in DeviceRow.Sort(house.Devices))
                    {
                        <DeviceRow @key="device.Id" Device="device" />
                    }
                </div>
            }

            @* ---- modals ---- *@
            @if (house.Capabilities.CanManageHouse)
            {
                <HouseModal Open="_editOpen" House="house" OnClose="() => _editOpen = false" OnSaved="OnHouseSaved" />
                <ConfirmDialog Open="_deleteOpen" OnClose="() => _deleteOpen = false" TestId="delete-house-dialog"
                               Title="@T("confirm.deleteTitle", new { name = house.Name })"
                               Message="@DeleteMessage(house)" OnConfirm="() => DeleteAsync(house)" Error="@_deleteError" />
            }
            @if (house.Capabilities.CanInviteTenants)
            {
                <MembersModal Open="_membersOpen" HouseId="@house.Id" HouseName="@house.Name"
                              CanManageMembers="house.Capabilities.CanManageMembers"
                              OnClose="() => _membersOpen = false" OnChanged="LoadMembersAsync" />
            }
            @if (house.Capabilities.CanEditDevices)
            {
                <DeviceModal Open="_addDeviceOpen" HouseId="@house.Id" OnClose="() => _addDeviceOpen = false" OnSaved="OnDeviceCreated" />
            }
        </ChildContent>
    </AsyncSection>
</div>

@code {
    [Parameter] public new string Locale { get; set; } = "fr";
    [Parameter] public string HouseId { get; set; } = "";

    private AsyncSection<HouseDetail>? _section;
    private List<string>? _memberNames;
    private string? _membersFor;

    private bool _editOpen, _membersOpen, _deleteOpen, _addDeviceOpen;
    private string? _deleteError;

    protected override void OnParametersSet()
    {
        // Switching house through the selector keeps this component: close everything.
        if (_membersFor is not null && _membersFor != HouseId)
        {
            _editOpen = _membersOpen = _deleteOpen = _addDeviceOpen = false;
            _memberNames = null;
            _membersFor = null;
        }
    }

    private async Task OnHouseLoaded(HouseDetail house)
    {
        if (_membersFor != house.Id) await LoadMembersAsync();
    }

    private async Task LoadMembersAsync()
    {
        var houseId = HouseId;
        _membersFor = houseId;
        try
        {
            var members = await Api.GetMembersAsync(houseId);
            if (houseId != HouseId) return;
            _memberNames = members.Select(m => $"{m.FirstName} {m.LastName}".Trim()).ToList();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or TaskCanceledException)
        {
            // Avatars are decorative: without them the header simply shows none.
            _memberNames = null;
        }
        StateHasChanged();
    }

    private static string FullAddress(HouseDetail house) =>
        string.Join(", ", new[] { house.Address, string.Join(" ", new[] { house.ZipCode, house.City }.Where(s => !string.IsNullOrWhiteSpace(s))) }
            .Where(s => !string.IsNullOrWhiteSpace(s)));

    private string DeleteMessage(HouseDetail house) => house.DevicesCount == 0
        ? T("houses.deleteMessageEmpty")
        : T("houses.deleteMessage", new { count = house.DevicesCount });

    private void AskDelete()
    {
        _deleteError = null;
        _deleteOpen = true;
    }

    private async Task DeleteAsync(HouseDetail house)
    {
        try
        {
            await Api.DeleteHouseAsync(house.Id);
            _deleteOpen = false;
            Toasts.Show(T("toast.deleted", new { name = house.Name }));
            _ = NavCounter.RefreshAsync();
            Nav.NavigateTo($"/{Locale}/houses");
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or TaskCanceledException)
        {
            _deleteError = T("houses.deleteError");
        }
    }

    private async Task OnHouseSaved(string _)
    {
        _editOpen = false;
        Toasts.Show(T("toast.changesSaved"));
        if (_section is not null) await _section.ReloadAsync();
    }

    private void OnDeviceCreated(string deviceId)
    {
        _addDeviceOpen = false;
        _ = NavCounter.RefreshAsync();
        Nav.NavigateTo($"/{Locale}/devices/{deviceId}");
    }
}
