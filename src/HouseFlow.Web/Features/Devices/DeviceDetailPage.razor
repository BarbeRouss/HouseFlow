@page "/{Locale}/devices/{DeviceId}"
@layout DashboardLayout
@inherits AppComponentBase
@inject ApiService Api
@inject NavigationManager Nav
@inject NavCounterService NavCounter
@inject ToastService Toasts
@using HouseFlow.Web.Features.Shared

@* P10 · Appareil (specs/ux P10). Breadcrumb « Maisons › {maison} › {appareil} » (< 640: « ‹ {maison} »);
   header: 72 px type tile · H1 + « {marque} {modèle} · installé(e) en {année} » · framed ⋯ (M2 edit,
   M6 delete → P09); « Entretiens »: C3 rows, P10 variant (status dot, periodicity in words, ⋯ always
   visible), sorted by due date + « Ajouter » action link (M4); « Historique »: every record, newest
   first, in a table (date · entretien · prestataire · coût, header on `surface-soft`, ≥ 640; under
   640 the date and provider move under the title), « Total : x € » (hidden when 0); row → M3 edit.
   Without CanViewCosts the cost column and the total are dropped (3 columns). R5 via the device
   capabilities: forbidden actions are hidden. 404/403 → P13. *@
<div class="hf-gutter mx-auto flex w-full max-w-app flex-col gap-[26px] pb-11 pt-7" data-testid="device-page">
    <MaintenanceActions @ref="_actions" OnChanged="ReloadAsync" Providers="_providers">
        <AsyncSection @ref="_section" TItem="PageData" Load="LoadAsync" Key="DeviceId">
            <Loading>
                <div class="flex flex-col gap-[26px]" aria-hidden="true">
                    <Skeleton Width="220px" Height="14px" />
                    <div class="flex items-center gap-[18px]">
                        <Skeleton Width="72px" Height="72px" Class="shrink-0 rounded-[20px]" />
                        <div class="flex flex-1 flex-col gap-2.5">
                            <Skeleton Width="55%" Height="32px" Class="rounded-lg" />
                            <Skeleton Width="35%" Height="14px" />
                        </div>
                    </div>
                    <div class="flex flex-col gap-3.5">
                        <Skeleton Width="140px" Height="22px" />
                        <SkeletonRows Count="2" ShowTrailing="true" />
                    </div>
                </div>
            </Loading>
            <ChildContent Context="data">
                @{ var device = data.Device; var caps = device.Capabilities; }
                <div class="flex flex-col gap-[26px]">
                    <Breadcrumb Items="@(new[]
                                {
                                    new Breadcrumb.Crumb(T("devicePage.houses"), $"/{Locale}/houses"),
                                    new Breadcrumb.Crumb(device.HouseName ?? T("devices.house"), $"/{Locale}/houses/{device.HouseId}"),
                                })"
                                Current="@device.Name" />

                    <div class="flex items-center gap-[18px]">
                        <DeviceTile Type="@device.Type" Size="72" />
                        <div class="min-w-0 flex-1">
                            <h1 class="hf-h1 break-words text-foreground" data-testid="device-name">@device.Name</h1>
                            @if (Subtitle(device) is { Length: > 0 } subtitle)
                            {
                                <p class="mt-1.5 text-[15px] text-muted-foreground" data-testid="device-subtitle">@subtitle</p>
                            }
                        </div>
                        @if (CanEditDevice(caps) || caps.CanDelete)
                        {
                            <OverflowMenu Small="false" TestId="device-menu" AriaLabel="@T("common.moreActions")" TriggerClass="shrink-0 self-start sm:self-center">
                                @if (CanEditDevice(caps))
                                {
                                    <MenuItem OnClick="() => _editing = true" IconName="pencil" TestId="device-edit">@T("devicePage.edit")</MenuItem>
                                }
                                @if (caps.CanDelete)
                                {
                                    <MenuItem OnClick="OpenDelete" IconName="trash-2" Destructive="true" TestId="device-delete">@T("devicePage.delete")</MenuItem>
                                }
                            </OverflowMenu>
                        }
                    </div>

                    @* ---- maintenances ---- *@
                    <section class="flex flex-col gap-3.5" aria-labelledby="device-types-title">
                        <div class="flex items-center justify-between gap-3">
                            <h2 id="device-types-title" class="hf-h2 text-foreground">@T("devicePage.maintenances")</h2>
                            @if (caps.CanEditDevices && data.Types.Count > 0)
                            {
                                <button type="button" class="hf-btn hf-btn-link gap-1.5 text-[15px]" data-testid="add-maintenance-type"
                                        aria-label="@T("maintenance.add")" @onclick="() => OpenTypeCreate(device.Id, device.Name)">
                                    <LucideIcon Name="plus" Size="18" aria-hidden="true" />
                                    @T("devicePage.add")
                                </button>
                            }
                        </div>
                        @if (data.Types.Count == 0)
                        {
                            <div class="hf-card flex flex-col items-center gap-3 px-6 py-10 text-center" data-testid="types-empty">
                                <p class="text-base text-muted-foreground">@T("devicePage.noTypes")</p>
                                @if (caps.CanEditDevices)
                                {
                                    <button type="button" class="hf-btn hf-btn-primary gap-[7px]" data-testid="add-maintenance-type"
                                            @onclick="() => OpenTypeCreate(device.Id, device.Name)">
                                        <LucideIcon Name="plus" Size="18" aria-hidden="true" />
                                        @T("maintenance.add")
                                    </button>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="hf-box" data-testid="maintenance-types">
                                @foreach (var item in data.Types)
                                {
                                    <MaintenanceRow @key="item.TypeId" Item="item" Context="MaintenanceRowContext.Device"
                                                    RecordCount="@data.History.Instances.Count(i => i.MaintenanceTypeId == item.TypeId)" />
                                }
                            </div>
                        }
                    </section>

                    @* ---- history ---- *@
                    <section class="flex flex-col gap-3.5" aria-labelledby="device-history-title">
                        <div class="flex flex-wrap items-baseline justify-between gap-1.5">
                            <h2 id="device-history-title" class="hf-h2 text-foreground">@T("devicePage.history")</h2>
                            @if (caps.CanViewCosts && data.Total > 0)
                            {
                                var total = FormatMoney(data.Total);
                                var parts = T("devicePage.total", new { amount = "\u0001" }).Split('\u0001');
                                <p class="text-[15px] text-muted-foreground" data-testid="history-total">@parts[0]<strong class="font-semibold text-foreground">@total</strong>@(parts.Length > 1 ? parts[1] : "")</p>
                            }
                        </div>
                        @if (data.Records.Count == 0)
                        {
                            <p class="hf-card px-6 py-6 text-center text-base text-muted-foreground" data-testid="history-empty">@T("devicePage.noHistory")</p>
                        }
                        else
                        {
                            var grid = HistoryGrid(caps.CanViewCosts);
                            <div class="hf-box" data-testid="history">
                                <div class="grid gap-3 bg-surface-soft px-4 py-[11px] text-[13px] font-semibold text-muted-foreground max-sm:hidden @grid" aria-hidden="true">
                                    <span>@T("devicePage.colDate")</span>
                                    <span>@T("devicePage.colMaintenance")</span>
                                    <span>@T("devicePage.colProvider")</span>
                                    @if (caps.CanViewCosts)
                                    {
                                        <span class="text-right">@T("devicePage.colCost")</span>
                                    }
                                </div>
                                <ul>
                                    @foreach (var record in data.Records)
                                    {
                                        var type = data.Types.FirstOrDefault(t => t.TypeId == record.MaintenanceTypeId);
                                        <li class="border-t border-divider first:max-sm:border-t-0">
                                            @if (type is { CanLog: true })
                                            {
                                                <button type="button" class="grid min-h-12 w-full items-center gap-3 px-4 py-[13px] text-left text-[15px] transition-colors hover:bg-accent focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring @grid"
                                                        data-testid="history-row" @onclick="() => OpenRecordEdit(type, record)">
                                                    @HistoryCells(record, caps.CanViewCosts)
                                                </button>
                                            }
                                            else
                                            {
                                                <div class="grid min-h-12 items-center gap-3 px-4 py-[13px] text-[15px] @grid" data-testid="history-row">@HistoryCells(record, caps.CanViewCosts)</div>
                                            }
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </section>
                </div>
            </ChildContent>
        </AsyncSection>
    </MaintenanceActions>
</div>

@if (_section?.Value is { } loaded)
{
    <ConfirmDialog Open="_deleting" OnClose="() => _deleting = false" TestId="device-delete-dialog"
                   Title="@T("confirm.deleteTitle", new { name = loaded.Device.Name })"
                   Message="@(loaded.Types.Count == 0 ? T("confirmDelete.deviceEmpty") : T("confirmDelete.device", new { count = loaded.Types.Count }))"
                   OnConfirm="DeleteDeviceAsync" Error="@_deleteError" />
    <DeviceModal Open="_editing" Device="loaded.Device" OnClose="() => _editing = false" OnSaved="OnDeviceSaved" />
}

@code {
    [Parameter] public new string Locale { get; set; } = "fr";
    [Parameter] public string DeviceId { get; set; } = "";

    private AsyncSection<PageData>? _section;
    private MaintenanceActions? _actions;
    private IReadOnlyList<string>? _providers;
    private bool _editing, _deleting;
    private string? _deleteError;

    // French types that take the feminine « installée ».
    private static readonly HashSet<string> FeminineTypes = new(StringComparer.OrdinalIgnoreCase)
    {
        "Chaudière Gaz", "Chaudière Fioul", "Pompe à Chaleur", "Climatisation", "VMC", "Toiture", "Alarme", "Pompe hydrophore",
    };

    private sealed record PageData(DeviceDetail Device, MaintenanceHistoryResponse History,
        List<MaintenanceRowItem> Types, List<MaintenanceInstance> Records, decimal Total);

    private async Task<PageData> LoadAsync()
    {
        var deviceTask = Api.GetDeviceAsync(DeviceId);
        var historyTask = Api.GetMaintenanceHistoryAsync(DeviceId);
        var device = await deviceTask;
        var history = await historyTask;
        var types = device.MaintenanceTypes
            .Select(t => MaintenanceRowItem.From(t, device))
            .OrderBy(i => DateFormatter.ParseDate(i.NextDueDate) ?? DateOnly.MaxValue)
            .ThenBy(i => i.Name, StringComparer.CurrentCultureIgnoreCase)
            .ToList();
        var records = history.Instances
            .OrderByDescending(r => DateFormatter.ParseDate(r.Date) ?? DateOnly.MinValue)
            .ThenByDescending(r => r.CreatedAt)
            .ToList();
        _providers = MaintenanceActions.DistinctProviders(records);
        return new PageData(device, history, types, records, records.Sum(r => r.Cost ?? 0));
    }

    private async Task ReloadAsync()
    {
        if (_section is not null) await _section.ReloadAsync();
        await NavCounter.RefreshAsync();
    }

    private static bool CanEditDevice(Capabilities caps) => caps.CanEditDevices;

    /// <summary>M2 edit saved: reload in place + « Modifications enregistrées ».</summary>
    private async Task OnDeviceSaved(string _)
    {
        _editing = false;
        await ReloadAsync();
        Toasts.Show(new ToastMessage(T("toast.changesSaved"), Array.Empty<ToastAction>(), TestId: "toast-changes-saved"));
    }

    private string Subtitle(DeviceDetail device)
    {
        var parts = new List<string>();
        var brandModel = string.Join(" ", new[] { device.Brand, device.Model }.Where(s => !string.IsNullOrWhiteSpace(s)).Select(s => s!.Trim()));
        if (brandModel.Length > 0) parts.Add(brandModel);
        if (DateFormatter.ParseDate(device.InstallDate) is { } installed)
            parts.Add(T(FeminineTypes.Contains(device.Type) ? "devicePage.installedFem" : "devicePage.installedMasc", new { year = installed.Year }));
        if (parts.Count == 0) parts.Add(DeviceCatalog.Label(device.Type, k => T(k)));
        return string.Join(" · ", parts);
    }

    /// <summary>
    /// History grid (specs/ux P10): date · entretien · prestataire · coût — 110 / 1fr / 170 / 80 px
    /// (640–1023), 130 / 1fr / 200 / 90 px (≥ 1024); under 640 px: title block · cost. Without
    /// CanViewCosts the cost column is dropped.
    /// </summary>
    private static string HistoryGrid(bool costs) => costs
        ? "grid-cols-[minmax(0,1fr)_auto] sm:grid-cols-[110px_minmax(0,1fr)_170px_80px] lg:grid-cols-[130px_minmax(0,1fr)_200px_90px]"
        : "grid-cols-[minmax(0,1fr)] sm:grid-cols-[110px_minmax(0,1fr)_170px] lg:grid-cols-[130px_minmax(0,1fr)_200px]";

    private RenderFragment HistoryCells(MaintenanceInstance record, bool costs) => __builder =>
    {
        var date = FormatDate(record.Date);
        var hasProvider = !string.IsNullOrWhiteSpace(record.Provider);
        <span class="text-muted-foreground max-sm:hidden">@date</span>
        <span class="min-w-0">
            <span class="block truncate font-semibold text-foreground">@record.MaintenanceTypeName</span>
            @* < 640: « 11 oct. 2025 · Chauffage Dumont » under the title. *@
            <span class="block truncate text-[13px] text-muted-foreground sm:hidden">@(hasProvider ? $"{date} · {record.Provider}" : date)</span>
        </span>
        <span class="min-w-0 truncate text-foreground max-sm:hidden" data-testid="history-provider">@record.Provider</span>
        @if (costs)
        {
            <span class="whitespace-nowrap text-right tabular-nums text-foreground">@(record.Cost is { } c ? FormatMoney(c) : "")</span>
        }
    };

    private void OpenTypeCreate(string deviceId, string deviceName) => _actions?.OpenTypeCreate(deviceId, deviceName);

    private Task OpenRecordEdit(MaintenanceRowItem type, MaintenanceInstance record) =>
        _actions?.OpenRecordEdit(type, record) ?? Task.CompletedTask;

    private void OpenDelete()
    {
        _deleteError = null;
        _deleting = true;
    }

    private async Task DeleteDeviceAsync()
    {
        if (_section?.Value is not { } data) return;
        _deleteError = null;
        try
        {
            await Api.DeleteDeviceAsync(DeviceId);
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or TaskCanceledException)
        {
            _deleteError = T("confirmDelete.error");
            return;
        }
        _deleting = false;
        _ = NavCounter.RefreshAsync();
        Toasts.Show(new ToastMessage(T("toast.deleted", new { name = data.Device.Name }), Array.Empty<ToastAction>(), TestId: "toast-deleted"));
        Nav.NavigateTo($"/{Locale}/houses/{data.Device.HouseId}");
    }
}
