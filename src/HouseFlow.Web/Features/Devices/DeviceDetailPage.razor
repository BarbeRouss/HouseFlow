@page "/{Locale}/devices/{DeviceId}"
@layout DashboardLayout
@inherits AppComponentBase
@inject ApiService Api
@inject NavigationManager Nav
@inject NavCounterService NavCounter
@inject ToastService Toasts
@using HouseFlow.Web.Features.Shared

@* P10 · Appareil. Breadcrumb « Maisons / {maison} / {appareil} »; header name + « {marque} {modèle} ·
   installé(e) en {année} » + ⋯ (M2 edit, M6 delete → P09); « Entretiens »: C3 rows (subtitle =
   periodicity in words, sorted by due date) + « Ajouter un entretien » (M4); « Historique »: every
   record, newest first, date · entretien · prestataire · coût, « Total » (hidden when 0), row → M3
   edit. R5 via the device capabilities: forbidden actions are hidden. 404/403 → P13. *@
<div class="mx-auto flex w-full max-w-[580px] flex-col gap-4 px-4 py-6 sm:py-8" data-testid="device-page">
    <MaintenanceActions @ref="_actions" OnChanged="ReloadAsync" Providers="_providers">
        <AsyncSection @ref="_section" TItem="PageData" Load="LoadAsync" Key="DeviceId">
            <Loading>
                <Skeleton Width="120px" Height="12px" />
                <SkeletonHeader ShowRing="false" />
                <Skeleton Width="30%" Height="16px" Class="mt-2" />
                <SkeletonRows />
            </Loading>
            <ChildContent Context="data">
                @{ var device = data.Device; var caps = device.Capabilities; }
                <nav aria-label="@T("houses.breadcrumb")" class="flex min-h-8 min-w-0 items-center gap-1.5 border-b border-dashed border-border pb-1 text-sm text-muted-foreground" data-testid="breadcrumb">
                    <a href="/@Locale/houses" class="inline-flex shrink-0 items-center hover:text-foreground hover:underline max-sm:min-h-11" data-testid="breadcrumb-houses">@T("devicePage.houses")</a>
                    <span aria-hidden="true">/</span>
                    <HouseSelector HouseId="@device.HouseId" HouseName="@(device.HouseName ?? T("devices.house"))" />
                    <span aria-hidden="true">/</span>
                    <span class="truncate text-foreground" aria-current="page">@device.Name</span>
                </nav>

                <div class="flex items-start justify-between gap-4">
                    <div class="flex min-w-0 flex-col gap-0.5">
                        <h1 class="break-words text-xl font-semibold text-foreground sm:text-2xl">@device.Name</h1>
                        @if (Subtitle(device) is { Length: > 0 } subtitle)
                        {
                            <p class="text-sm text-muted-foreground" data-testid="device-subtitle">@subtitle</p>
                        }
                    </div>
                    @if (CanEditDevice(caps) || caps.CanDelete)
                    {
                        <OverflowMenu Small="false" TestId="device-menu" AriaLabel="@T("common.moreActions")">
                            @if (CanEditDevice(caps))
                            {
                                <MenuItem OnClick="() => _editing = true" IconName="pencil" TestId="device-edit">@T("devicePage.edit")</MenuItem>
                            }
                            @if (caps.CanDelete)
                            {
                                <MenuItem OnClick="OpenDelete" IconName="trash-2" Destructive="true" TestId="device-delete">@T("devicePage.delete")</MenuItem>
                            }
                        </OverflowMenu>
                    }
                </div>

                <div class="mt-2 flex items-center justify-between gap-3">
                    <h2 class="text-lg font-semibold text-foreground">@T("devicePage.maintenances")</h2>
                    @if (caps.CanEditDevices && data.Types.Count > 0)
                    {
                        <button type="button" class="hf-btn hf-btn-outline hf-btn-sm" data-testid="add-maintenance-type"
                                @onclick="() => OpenTypeCreate(device.Id)">
                            @T("maintenance.add")
                        </button>
                    }
                </div>
                @if (data.Types.Count == 0)
                {
                    <div class="hf-box flex flex-col items-center gap-3 px-5 py-10 text-center" data-testid="types-empty">
                        <p class="text-sm text-foreground">@T("devicePage.noTypes")</p>
                        @if (caps.CanEditDevices)
                        {
                            <button type="button" class="hf-btn hf-btn-primary" data-testid="add-maintenance-type"
                                    @onclick="() => OpenTypeCreate(device.Id)">
                                @T("maintenance.add")
                            </button>
                        }
                    </div>
                }
                else
                {
                    <div class="hf-box" data-testid="maintenance-types">
                        @foreach (var item in data.Types)
                        {
                            <MaintenanceRow @key="item.TypeId" Item="item" Context="MaintenanceRowContext.Device"
                                            RecordCount="@data.History.Instances.Count(i => i.MaintenanceTypeId == item.TypeId)" />
                        }
                    </div>
                }

                <div class="mt-2 flex items-center justify-between gap-3">
                    <h2 class="text-lg font-semibold text-foreground">@T("devicePage.history")</h2>
                    @if (caps.CanViewCosts && data.Total > 0)
                    {
                        <span class="text-sm text-muted-foreground" data-testid="history-total">@T("devicePage.total", new { amount = FormatMoney(data.Total) })</span>
                    }
                </div>
                @if (data.Records.Count == 0)
                {
                    <p class="hf-box px-5 py-6 text-center text-sm text-muted-foreground" data-testid="history-empty">@T("devicePage.noHistory")</p>
                }
                else
                {
                    <ul class="hf-box" data-testid="history">
                        @foreach (var record in data.Records)
                        {
                            var type = data.Types.FirstOrDefault(t => t.TypeId == record.MaintenanceTypeId);
                            <li class="border-b border-dashed border-border last:border-b-0">
                                @if (type is { CanLog: true })
                                {
                                    <button type="button" class="flex min-h-11 w-full items-center gap-2.5 px-3 py-2.5 text-left text-sm hover:bg-accent focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring"
                                            data-testid="history-row" @onclick="() => OpenRecordEdit(type, record)">
                                        @HistoryCells(record)
                                    </button>
                                }
                                else
                                {
                                    <div class="flex min-h-11 items-center gap-2.5 px-3 py-2.5 text-sm" data-testid="history-row">@HistoryCells(record)</div>
                                }
                            </li>
                        }
                    </ul>
                }
            </ChildContent>
        </AsyncSection>
    </MaintenanceActions>
</div>

@if (_section?.Value is { } loaded)
{
    <ConfirmDialog Open="_deleting" OnClose="() => _deleting = false" TestId="device-delete-dialog"
                   Title="@T("confirm.deleteTitle", new { name = loaded.Device.Name })"
                   Message="@(loaded.Types.Count == 0 ? T("confirmDelete.deviceEmpty") : T("confirmDelete.device", new { count = loaded.Types.Count }))"
                   OnConfirm="DeleteDeviceAsync" Error="@_deleteError" />
    <DeviceModal Open="_editing" Device="loaded.Device" OnClose="() => _editing = false" OnSaved="OnDeviceSaved" />
}

@code {
    [Parameter] public new string Locale { get; set; } = "fr";
    [Parameter] public string DeviceId { get; set; } = "";

    private AsyncSection<PageData>? _section;
    private MaintenanceActions? _actions;
    private IReadOnlyList<string>? _providers;
    private bool _editing, _deleting;
    private string? _deleteError;

    // French types that take the feminine « installée ».
    private static readonly HashSet<string> FeminineTypes = new(StringComparer.OrdinalIgnoreCase)
    {
        "Chaudière Gaz", "Chaudière Fioul", "Pompe à Chaleur", "Climatisation", "VMC", "Toiture", "Alarme", "Pompe hydrophore",
    };

    private sealed record PageData(DeviceDetail Device, MaintenanceHistoryResponse History,
        List<MaintenanceRowItem> Types, List<MaintenanceInstance> Records, decimal Total);

    private async Task<PageData> LoadAsync()
    {
        var deviceTask = Api.GetDeviceAsync(DeviceId);
        var historyTask = Api.GetMaintenanceHistoryAsync(DeviceId);
        var device = await deviceTask;
        var history = await historyTask;
        var types = device.MaintenanceTypes
            .Select(t => MaintenanceRowItem.From(t, device))
            .OrderBy(i => DateFormatter.ParseDate(i.NextDueDate) ?? DateOnly.MaxValue)
            .ThenBy(i => i.Name, StringComparer.CurrentCultureIgnoreCase)
            .ToList();
        var records = history.Instances
            .OrderByDescending(r => DateFormatter.ParseDate(r.Date) ?? DateOnly.MinValue)
            .ThenByDescending(r => r.CreatedAt)
            .ToList();
        _providers = MaintenanceActions.DistinctProviders(records);
        return new PageData(device, history, types, records, records.Sum(r => r.Cost ?? 0));
    }

    private async Task ReloadAsync()
    {
        if (_section is not null) await _section.ReloadAsync();
        await NavCounter.RefreshAsync();
    }

    private static bool CanEditDevice(Capabilities caps) => caps.CanEditDevices;

    /// <summary>M2 edit saved: reload in place + « Modifications enregistrées ».</summary>
    private async Task OnDeviceSaved(string _)
    {
        _editing = false;
        await ReloadAsync();
        Toasts.Show(new ToastMessage(T("toast.changesSaved"), Array.Empty<ToastAction>(), TestId: "toast-changes-saved"));
    }

    private string Subtitle(DeviceDetail device)
    {
        var parts = new List<string>();
        var brandModel = string.Join(" ", new[] { device.Brand, device.Model }.Where(s => !string.IsNullOrWhiteSpace(s)).Select(s => s!.Trim()));
        if (brandModel.Length > 0) parts.Add(brandModel);
        if (DateFormatter.ParseDate(device.InstallDate) is { } installed)
            parts.Add(T(FeminineTypes.Contains(device.Type) ? "devicePage.installedFem" : "devicePage.installedMasc", new { year = installed.Year }));
        if (parts.Count == 0) parts.Add(DeviceCatalog.Label(device.Type, k => T(k)));
        return string.Join(" · ", parts);
    }

    private RenderFragment HistoryCells(MaintenanceInstance record) => __builder =>
    {
        <span class="w-[92px] shrink-0 text-muted-foreground">@FormatDate(record.Date)</span>
        @* 4 columns (date · entretien · prestataire · coût); under 400 px the provider stacks under
           the maintenance name instead of being dropped. *@
        <span class="flex min-w-0 flex-1 flex-col min-[400px]:flex-row min-[400px]:items-center min-[400px]:gap-2.5">
            <span class="min-w-0 truncate text-foreground min-[400px]:flex-1">@record.MaintenanceTypeName</span>
            @if (!string.IsNullOrWhiteSpace(record.Provider))
            {
                <span class="min-w-0 truncate text-xs text-muted-foreground min-[400px]:max-w-[40%] min-[400px]:text-sm" data-testid="history-provider">@record.Provider</span>
            }
        </span>
        <span class="w-[64px] shrink-0 text-right tabular-nums text-foreground">@(record.Cost is { } c ? FormatMoney(c) : "")</span>
    };

    private void OpenTypeCreate(string deviceId) => _actions?.OpenTypeCreate(deviceId);

    private Task OpenRecordEdit(MaintenanceRowItem type, MaintenanceInstance record) =>
        _actions?.OpenRecordEdit(type, record) ?? Task.CompletedTask;

    private void OpenDelete()
    {
        _deleteError = null;
        _deleting = true;
    }

    private async Task DeleteDeviceAsync()
    {
        if (_section?.Value is not { } data) return;
        _deleteError = null;
        try
        {
            await Api.DeleteDeviceAsync(DeviceId);
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or TaskCanceledException)
        {
            _deleteError = T("confirmDelete.error");
            return;
        }
        _deleting = false;
        _ = NavCounter.RefreshAsync();
        Toasts.Show(new ToastMessage(T("toast.deleted", new { name = data.Device.Name }), Array.Empty<ToastAction>(), TestId: "toast-deleted"));
        Nav.NavigateTo($"/{Locale}/houses/{data.Device.HouseId}");
    }
}
