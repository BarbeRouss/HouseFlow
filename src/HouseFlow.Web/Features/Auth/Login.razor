@page "/{Locale}/login"
@layout AuthLayout
@inherits AppComponentBase
@inject ApiService Api
@inject TokenStore Tokens
@inject AppAuthStateProvider AuthState
@inject RedirectGuard Redirect
@inject ThemeService Theme
@inject NavigationManager Nav
@inject AppConfig Config

@* P02 · Connexion (specs/ux P02). No C1/C8. Grid: the form column alone (< 1024, form centred on
   400 px) or the form column + the 520 px indigo panel (≥ 1024).
   Form column: logo line 44 px · centred block (« Bon retour » + subtitle, error banner late-soft
   without border, Email, Mot de passe with a 44 px eye button, « Se souvenir de moi », « Se
   connecter » full width, « Pas encore de compte ? Créer un compte », demo login) · compact C7 footer
   at the bottom of the column (frozen footer.* labels; AuthLayout draws no footer on this page).
   Panel: three C3-like cards from DemoData (decorative) + the tagline. *@
<div class="grid flex-1 lg:grid-cols-[minmax(0,1fr)_520px]">
    <div class="hf-gutter flex flex-col gap-6 pb-5 pt-4">
        <div class="flex h-11 items-center gap-[9px]">
            <Logo Size="28" />
            <span class="font-display text-[19px] font-bold tracking-[-.01em] text-foreground">HouseFlow</span>
        </div>

        <form @onsubmit="Submit" @onsubmit:preventDefault="true" class="mx-auto flex w-full max-w-login flex-1 flex-col justify-center gap-[18px]">
            <div>
                <h1 class="hf-h1-form text-foreground">@T("auth.loginTitle")</h1>
                <p class="mt-2 text-base text-muted-foreground">@T("auth.loginSubtitle")</p>
            </div>

            @if (_error is not null)
            {
                <div id="login-error" class="hf-alert-error flex items-start gap-2.5 text-[15px]" role="alert" data-testid="login-error" data-code="@_errorCode">
                    <LucideIcon Name="circle-alert" Size="17" Class="mt-0.5 shrink-0" aria-hidden="true" />
                    <span>
                        @switch (_error)
                        {
                            case LoginError.AccountRestricted:
                                @T("auth.accountRestricted")<a href="mailto:@LegalConstants.PrivacyContactEmail" class="font-semibold underline">@LegalConstants.PrivacyContactEmail</a>@T("auth.accountRestrictedSuffix")
                                break;
                            case LoginError.InvalidCredentials:
                                @T("auth.invalidCredentials")
                                break;
                            default:
                                @T("common.unexpectedError")
                                break;
                        }
                    </span>
                </div>
            }

            <div>
                <label for="email" class="hf-label">@T("auth.email")</label>
                <input id="email" type="email" autocomplete="username" @bind="_email" @bind:event="oninput" required
                       placeholder="@T("auth.emailPlaceholder")" class="hf-input" />
            </div>

            <div>
                <label for="password" class="hf-label">@T("auth.password")</label>
                <div class="relative">
                    <input id="password" @ref="_passwordInput" type="@(_showPassword ? "text" : "password")"
                           autocomplete="current-password" @bind="_password" @bind:event="oninput" required
                           placeholder="••••••••" class="hf-input pr-12 @(_showPassword ? "" : "tracking-[.2em]")"
                           aria-invalid="@(_error == LoginError.InvalidCredentials ? "true" : null)"
                           aria-describedby="@(_error is null ? null : "login-error")" />
                    <button type="button" class="absolute right-1 top-1/2 flex size-11 -translate-y-1/2 items-center justify-center rounded-lg text-muted-foreground hover:text-foreground focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring"
                            aria-label="@T(_showPassword ? "auth.hidePassword" : "auth.showPassword")"
                            aria-pressed="@(_showPassword ? "true" : "false")" aria-controls="password"
                            data-testid="toggle-password"
                            @onclick="() => _showPassword = !_showPassword">
                        <LucideIcon Name="@(_showPassword ? "eye-off" : "eye")" Size="18" aria-hidden="true" />
                    </button>
                </div>
            </div>

            <label for="rememberMe" class="-my-1.5 flex min-h-11 cursor-pointer items-center gap-3 self-start text-[15px] text-foreground">
                <input id="rememberMe" type="checkbox" @bind="_rememberMe" class="hf-checkbox" />
                @T("auth.rememberMe")
            </label>

            <button type="submit" disabled="@_busy" class="hf-btn hf-btn-primary hf-btn-block">
                <BusyLabel Busy="_busy">@T("auth.login")</BusyLabel>
            </button>

            <p class="text-center text-[15px] text-muted-foreground">
                @T("auth.dontHaveAccount")
                <a href="@RegisterHref" class="hf-link font-semibold">@T("auth.createAccountLink")</a>
            </p>

            @if (Config.DemoMode)
            {
                <div class="flex items-center gap-2 text-xs text-muted-foreground" aria-hidden="true">
                    <span class="h-px flex-1 bg-border"></span>
                    <span>@T("auth.demoEnvironment")</span>
                    <span class="h-px flex-1 bg-border"></span>
                </div>
                <button type="button" @onclick="DemoLogin" disabled="@_busy" class="hf-btn hf-btn-outline hf-btn-block">
                    @T("auth.demoLogin")
                </button>
            }
        </form>

        <Footer Compact="true" />
    </div>

    @* ≥ 1024 only, decorative: the tagline is the only text worth reading, the cards illustrate it. *@
    <div class="hidden flex-col justify-between gap-7 bg-brand-panel px-12 pb-12 pt-[72px] lg:flex" data-testid="login-panel">
        <div class="flex flex-col gap-3" aria-hidden="true">
            @foreach (var task in PanelTasks)
            {
                <div class="flex items-center gap-3.5 rounded-[14px] bg-card px-[18px] py-3.5 shadow-panel">
                    <DeviceTile Type="@task.DeviceType" Size="44" />
                    <div class="min-w-0 flex-1">
                        <div class="text-base font-semibold text-foreground">@task.Name</div>
                        <div class="text-[13px] text-muted-foreground">@task.DeviceName</div>
                    </div>
                    <StatusBadge Status="task.DueStatus" Text="@Due(task)" Plain="true" Class="text-sm" />
                </div>
            }
        </div>
        <p class="max-w-[420px] font-display text-[30px] font-semibold leading-[1.15] tracking-[-.015em] text-balance text-white">@T("auth.loginTagline")</p>
    </div>
</div>

@code {
    [Parameter] public new string Locale { get; set; } = "fr";

    /// <summary>R6: page to return to after login (validated by AppRoutes.SafeReturnUrl).</summary>
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    /// <summary>"restricted": the session ended because a refresh answered account_restricted (art. 18).</summary>
    [SupplyParameterFromQuery] public string? Reason { get; set; }

    private enum LoginError { InvalidCredentials, AccountRestricted, Unexpected }

    private string _email = "";
    private string _password = "";
    private bool _rememberMe;
    private bool _showPassword;
    private bool _busy;
    private LoginError? _error;
    private string? _errorCode;
    private bool _focusPassword;
    private ElementReference _passwordInput;

    /// <summary>"Créer un compte" → P03, keeping the returnUrl (e.g. coming from P04).</summary>
    private string RegisterHref
    {
        get
        {
            var safe = AppRoutes.SafeReturnUrl(ReturnUrl);
            return safe is null
                ? $"/{Locale}/register"
                : $"/{Locale}/register?returnUrl={Uri.EscapeDataString(safe)}";
        }
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        // A refresh refused for a restricted account lands here: same message as at login.
        if (Reason == AppRoutes.RestrictedReason)
        {
            _error = LoginError.AccountRestricted;
            _errorCode = ApiErrorCodes.AccountRestricted;
        }
    }

    private async Task DemoLogin()
    {
        _email = "demo@demo.com";
        _password = "Demo@2026!";
        await Submit();
    }

    private async Task Submit()
    {
        if (_busy) return;
        _busy = true;
        _error = null;
        _errorCode = null;
        try
        {
            var res = await Api.LoginAsync(new LoginRequest(_email, _password, _rememberMe));
            await ApplyLogin(res);
        }
        catch (ApiException ex)
        {
            _errorCode = ex.Code;
            if (ex.Code == ApiErrorCodes.AccountRestricted)
            {
                // Art. 18: the credentials were right — keep the password.
                _error = LoginError.AccountRestricted;
            }
            else if (ex.Code == ApiErrorCodes.InvalidCredentials || ex.StatusCode is 400 or 401)
            {
                // One message, without saying which field is wrong; clear the password and focus it.
                _error = LoginError.InvalidCredentials;
                _password = "";
                _focusPassword = true;
            }
            else
            {
                _error = LoginError.Unexpected;
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            // API unreachable: generic message, the form stays as typed.
            _error = LoginError.Unexpected;
        }
        finally
        {
            _busy = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusPassword)
        {
            _focusPassword = false;
            await _passwordInput.FocusAsync();
        }
    }

    private async Task ApplyLogin(AuthResponse res)
    {
        await Tokens.SetSessionAsync(res.AccessToken, AuthUser.FromDto(res.User));
        AuthState.NotifyChanged();

        if (!string.IsNullOrEmpty(res.User.Theme) && res.User.Theme is "light" or "dark" or "system")
            await Theme.SetThemeAsync(res.User.Theme);

        var target = Localizer.IsSupported(res.User.Language) ? res.User.Language! : Locale;
        Redirect.SetFormRedirecting();
        Nav.NavigateTo(AppRoutes.AfterLogin(ReturnUrl, target), replace: true);
    }

    /// <summary>P02 panel cards: the DemoData tasks (same data as the P01 preview).</summary>
    private IEnumerable<MaintenanceRowItem> PanelTasks =>
        HouseFlow.Web.Features.Shared.DemoData.Build(ParisClock.Today, key => T(key)).Tasks.Select(x => MaintenanceRowItem.From(x));

    /// <summary>« En retard de 8 j », « Dans 12 j »: capital at the start (specs/ux C3).</summary>
    private string Due(MaintenanceRowItem task)
    {
        var text = RelativeDate(task.NextDueDate);
        return text.Length == 0 ? text : char.ToUpper(text[0], new System.Globalization.CultureInfo(Locale)) + text[1..];
    }
}
