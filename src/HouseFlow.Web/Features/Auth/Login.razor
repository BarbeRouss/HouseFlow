@page "/{Locale}/login"
@layout AuthLayout
@inherits AppComponentBase
@inject ApiService Api
@inject TokenStore Tokens
@inject AppAuthStateProvider AuthState
@inject RedirectGuard Redirect
@inject ThemeService Theme
@inject NavigationManager Nav
@inject AppConfig Config

<div class="flex flex-1 items-center justify-center bg-gradient-to-br from-gray-50 to-gray-100 dark:from-gray-900 dark:to-gray-800 px-4">
    <div class="w-full max-w-md">
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-xl p-4 sm:p-8">
            <div class="text-center mb-8 flex flex-col items-center gap-3">
                <Logo Size="56" />
                <h1 class="text-3xl font-bold text-gray-900 dark:text-white">HouseFlow</h1>
                <p class="text-gray-600 dark:text-gray-400">@T("auth.tagline")</p>
            </div>

            <form @onsubmit="Submit" @onsubmit:preventDefault="true" class="space-y-6">
                @if (_error is not null)
                {
                    <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 text-red-600 dark:text-red-400 px-4 py-3 rounded">
                        @_error
                    </div>
                }

                <div>
                    <label for="email" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">@T("auth.email")</label>
                    <input id="email" type="email" @bind="_email" @bind:event="oninput" required placeholder="you@example.com"
                           class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-white" />
                </div>

                <div>
                    <label for="password" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">@T("auth.password")</label>
                    <input id="password" type="password" @bind="_password" @bind:event="oninput" required placeholder="••••••••"
                           class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-white" />
                </div>

                <div class="flex items-center gap-2">
                    <input id="rememberMe" type="checkbox" @bind="_rememberMe"
                           class="h-4 w-4 rounded border-gray-300 dark:border-gray-600 text-blue-600 focus:ring-blue-500 dark:bg-gray-700" />
                    <label for="rememberMe" class="text-sm text-gray-700 dark:text-gray-300">@T("auth.rememberMe")</label>
                </div>

                <button type="submit" disabled="@_busy"
                        class="w-full bg-blue-600 hover:bg-blue-700 disabled:bg-blue-400 text-white font-semibold py-2 px-4 rounded-md transition-colors">
                    @(_busy ? T("common.loading") : T("auth.login"))
                </button>

                @if (Config.DemoMode)
                {
                    <div class="relative">
                        <div class="absolute inset-0 flex items-center">
                            <div class="w-full border-t border-gray-300 dark:border-gray-600"></div>
                        </div>
                        <div class="relative flex justify-center text-xs">
                            <span class="bg-white dark:bg-gray-800 px-2 text-gray-500 dark:text-gray-400">@T("auth.demoEnvironment")</span>
                        </div>
                    </div>
                    <button type="button" @onclick="DemoLogin" disabled="@_busy"
                            class="w-full bg-amber-500 hover:bg-amber-600 disabled:bg-amber-300 text-white font-semibold py-2 px-4 rounded-md transition-colors">
                        @T("auth.demoLogin")
                    </button>
                }

                <div class="text-center text-sm text-gray-600 dark:text-gray-400">
                    @T("auth.dontHaveAccount")
                    <a href="/@Locale/register" class="text-blue-600 dark:text-blue-400 hover:underline">@T("auth.register")</a>
                </div>

                @* RGPD Art. 12(1)/13 — la politique doit être atteignable depuis l'écran de
                   connexion, pas seulement depuis le pied de page. *@
                <div class="text-center text-xs text-gray-500 dark:text-gray-400">
                    <a href="/@Locale/privacy" class="hover:underline">@T("legal.privacyTitle")</a>
                </div>
            </form>
        </div>
    </div>
</div>

@code {
    [Parameter] public string Locale { get; set; } = "fr";

    private string _email = "";
    private string _password = "";
    private bool _rememberMe;
    private bool _busy;
    private string? _error;

    private async Task DemoLogin()
    {
        _email = "demo@demo.com";
        _password = "Demo@2026!";
        await Submit();
    }

    private async Task Submit()
    {
        _busy = true;
        _error = null;
        try
        {
            var res = await Api.LoginAsync(new LoginRequest(_email, _password, _rememberMe));
            await ApplyLogin(res);
        }
        catch (ApiException ex)
        {
            _error = string.IsNullOrWhiteSpace(ex.Message) ? T("auth.loginError") : ex.Message;
        }
        catch
        {
            _error = T("auth.loginError");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ApplyLogin(AuthResponse res)
    {
        await Tokens.SetSessionAsync(res.AccessToken, AuthUser.FromDto(res.User));
        AuthState.NotifyChanged();

        if (!string.IsNullOrEmpty(res.User.Theme) && res.User.Theme is "light" or "dark" or "system")
            await Theme.SetThemeAsync(res.User.Theme);

        var target = Localizer.IsSupported(res.User.Language) ? res.User.Language! : Locale;
        Redirect.SetFormRedirecting();
        Nav.NavigateTo($"/{target}/dashboard", replace: true);
    }
}
