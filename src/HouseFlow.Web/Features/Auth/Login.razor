@page "/{Locale}/login"
@layout AuthLayout
@inherits AppComponentBase
@inject ApiService Api
@inject TokenStore Tokens
@inject AppAuthStateProvider AuthState
@inject RedirectGuard Redirect
@inject ThemeService Theme
@inject NavigationManager Nav
@inject AppConfig Config

@* P02 · Connexion. No C1/C8; the C7 legal footer comes from MainLayout (via AuthLayout) and
   replaces the isolated privacy link that used to sit under the form (RGPD art. 12(1)/13). *@
<div class="flex flex-1 items-center justify-center px-4 py-10">
    <div class="w-full max-w-[380px] rounded-lg border border-border bg-card px-5 py-6 sm:px-[30px] sm:py-[26px]">
        <div class="mb-4 flex items-center gap-2">
            <Logo Size="28" />
            <h2 class="text-lg font-semibold text-foreground">HouseFlow</h2>
        </div>

        <form @onsubmit="Submit" @onsubmit:preventDefault="true" class="flex flex-col gap-3">
            <h1 class="text-2xl font-semibold text-foreground">@T("auth.loginTitle")</h1>

            <div>
                <label for="email" class="hf-label">@T("auth.email")</label>
                <input id="email" type="email" autocomplete="username" @bind="_email" @bind:event="oninput" required
                       placeholder="@T("auth.emailPlaceholder")" class="hf-input" />
            </div>

            <div>
                <label for="password" class="hf-label">@T("auth.password")</label>
                <div class="relative">
                    <input id="password" @ref="_passwordInput" type="@(_showPassword ? "text" : "password")"
                           autocomplete="current-password" @bind="_password" @bind:event="oninput" required
                           placeholder="••••••••" class="hf-input pr-20"
                           aria-invalid="@(_error == LoginError.InvalidCredentials ? "true" : null)"
                           aria-describedby="@(_error is null ? null : "login-error")" />
                    <button type="button" class="absolute inset-y-0 right-0 flex items-center px-3 text-sm font-medium text-primary-strong hover:underline"
                            aria-pressed="@(_showPassword ? "true" : "false")" aria-controls="password"
                            @onclick="() => _showPassword = !_showPassword">
                        @T(_showPassword ? "auth.hidePassword" : "auth.showPassword")
                    </button>
                </div>
            </div>

            <div class="flex items-center gap-2">
                <input id="rememberMe" type="checkbox" @bind="_rememberMe" class="h-4 w-4 rounded border-input accent-primary" />
                <label for="rememberMe" class="text-sm text-foreground">@T("auth.rememberMe")</label>
            </div>

            @if (_error is not null)
            {
                <div id="login-error" class="hf-alert-error" role="alert" data-testid="login-error" data-code="@_errorCode">
                    @switch (_error)
                    {
                        case LoginError.AccountRestricted:
                            @T("auth.accountRestricted")<a href="mailto:@LegalConstants.PrivacyContactEmail" class="font-medium underline">@LegalConstants.PrivacyContactEmail</a>@T("auth.accountRestrictedSuffix")
                            break;
                        case LoginError.InvalidCredentials:
                            @T("auth.invalidCredentials")
                            break;
                        default:
                            @T("common.unexpectedError")
                            break;
                    }
                </div>
            }

            <button type="submit" disabled="@_busy" class="hf-btn hf-btn-primary w-full">
                <BusyLabel Busy="_busy">@T("auth.login")</BusyLabel>
            </button>

            @if (Config.DemoMode)
            {
                <div class="flex items-center gap-2 text-xs text-muted-foreground" aria-hidden="true">
                    <span class="h-px flex-1 bg-border"></span>
                    <span>@T("auth.demoEnvironment")</span>
                    <span class="h-px flex-1 bg-border"></span>
                </div>
                <button type="button" @onclick="DemoLogin" disabled="@_busy" class="hf-btn hf-btn-outline w-full">
                    @T("auth.demoLogin")
                </button>
            }

            <p class="text-center text-sm text-muted-foreground">
                @T("auth.dontHaveAccount")
                <a href="@RegisterHref" class="hf-link">@T("auth.createAccountLink")</a>
            </p>
        </form>
    </div>
</div>

@code {
    [Parameter] public new string Locale { get; set; } = "fr";

    /// <summary>R6: page to return to after login (validated by AppRoutes.SafeReturnUrl).</summary>
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    /// <summary>"restricted": the session ended because a refresh answered account_restricted (art. 18).</summary>
    [SupplyParameterFromQuery] public string? Reason { get; set; }

    private enum LoginError { InvalidCredentials, AccountRestricted, Unexpected }

    private string _email = "";
    private string _password = "";
    private bool _rememberMe;
    private bool _showPassword;
    private bool _busy;
    private LoginError? _error;
    private string? _errorCode;
    private bool _focusPassword;
    private ElementReference _passwordInput;

    /// <summary>"Créer un compte" → P03, keeping the returnUrl (e.g. coming from P04).</summary>
    private string RegisterHref
    {
        get
        {
            var safe = AppRoutes.SafeReturnUrl(ReturnUrl);
            return safe is null
                ? $"/{Locale}/register"
                : $"/{Locale}/register?returnUrl={Uri.EscapeDataString(safe)}";
        }
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        // A refresh refused for a restricted account lands here: same message as at login.
        if (Reason == AppRoutes.RestrictedReason)
        {
            _error = LoginError.AccountRestricted;
            _errorCode = ApiErrorCodes.AccountRestricted;
        }
    }

    private async Task DemoLogin()
    {
        _email = "demo@demo.com";
        _password = "Demo@2026!";
        await Submit();
    }

    private async Task Submit()
    {
        if (_busy) return;
        _busy = true;
        _error = null;
        _errorCode = null;
        try
        {
            var res = await Api.LoginAsync(new LoginRequest(_email, _password, _rememberMe));
            await ApplyLogin(res);
        }
        catch (ApiException ex)
        {
            _errorCode = ex.Code;
            if (ex.Code == ApiErrorCodes.AccountRestricted)
            {
                // Art. 18: the credentials were right — keep the password.
                _error = LoginError.AccountRestricted;
            }
            else if (ex.Code == ApiErrorCodes.InvalidCredentials || ex.StatusCode is 400 or 401)
            {
                // One message, without saying which field is wrong; clear the password and focus it.
                _error = LoginError.InvalidCredentials;
                _password = "";
                _focusPassword = true;
            }
            else
            {
                _error = LoginError.Unexpected;
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            // API unreachable: generic message, the form stays as typed.
            _error = LoginError.Unexpected;
        }
        finally
        {
            _busy = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusPassword)
        {
            _focusPassword = false;
            await _passwordInput.FocusAsync();
        }
    }

    private async Task ApplyLogin(AuthResponse res)
    {
        await Tokens.SetSessionAsync(res.AccessToken, AuthUser.FromDto(res.User));
        AuthState.NotifyChanged();

        if (!string.IsNullOrEmpty(res.User.Theme) && res.User.Theme is "light" or "dark" or "system")
            await Theme.SetThemeAsync(res.User.Theme);

        var target = Localizer.IsSupported(res.User.Language) ? res.User.Language! : Locale;
        Redirect.SetFormRedirecting();
        Nav.NavigateTo(AppRoutes.AfterLogin(ReturnUrl, target), replace: true);
    }
}
