@page "/{Locale}/register"
@layout AuthLayout
@inherits AppComponentBase
@inject ApiService Api
@inject TokenStore Tokens
@inject AppAuthStateProvider AuthState
@inject RedirectGuard Redirect
@inject NavigationManager Nav
@inject ToastService Toasts

@* P03 · Inscription. Standard: stepper 1/3, "Continuer" → P05 (or the returnUrl kept from P02).
   Invitation (?invitation={token}): no stepper, email locked to the invited address,
   "Créer mon compte et rejoindre" → the invitation is accepted by the API → P09 + toast.
   No C1/C8; the C7 footer comes from MainLayout (via AuthLayout). *@
<div class="flex flex-1 items-center justify-center px-4 py-10">
    <div class="w-full max-w-[380px] rounded-lg border border-border bg-card px-5 py-6 sm:px-[30px] sm:py-[22px]">
        <form @onsubmit="Submit" @onsubmit:preventDefault="true" class="flex flex-col gap-3">
            @if (!IsInvitationMode)
            {
                <Stepper Current="1" />
            }

            <h1 class="text-2xl font-semibold text-foreground">@T("auth.registerTitle")</h1>

            @if (_invitationLoading)
            {
                <Skeleton Width="70%" Height="14px" />
            }
            else if (IsInvitationMode)
            {
                <p class="text-sm text-muted-foreground" data-testid="register-invitation">@T("auth.joiningHouse", new { house = _invitation!.HouseName })</p>
            }
            else if (_invitationUnusable)
            {
                <div class="hf-alert-error" role="alert" data-testid="register-invitation-invalid">@T("invitations.invalidTitle")</div>
            }

            @if (_error is not null)
            {
                <div class="hf-alert-error" role="alert" data-testid="register-error" data-code="@_errorCode">@_error</div>
            }

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label for="firstName" class="hf-label">@T("auth.firstName")</label>
                    <input id="firstName" type="text" autocomplete="given-name" @bind="_firstName" @bind:event="oninput"
                           required maxlength="100" placeholder="@T("auth.firstNamePlaceholder")" class="hf-input" />
                </div>
                <div>
                    <label for="lastName" class="hf-label">@T("auth.lastName")</label>
                    <input id="lastName" type="text" autocomplete="family-name" @bind="_lastName" @bind:event="oninput"
                           required maxlength="100" placeholder="@T("auth.lastNamePlaceholder")" class="hf-input" />
                </div>
            </div>

            <div>
                <label for="email" class="hf-label">@T("auth.email")</label>
                <input id="email" type="email" autocomplete="email" @bind="_email" @bind:event="oninput"
                       required maxlength="255" placeholder="@T("auth.emailPlaceholder")"
                       readonly="@EmailLocked" aria-readonly="@(EmailLocked ? "true" : null)"
                       class="hf-input @(EmailLocked ? "bg-muted text-muted-foreground" : "")"
                       aria-invalid="@(_emailError is not null ? "true" : null)"
                       aria-describedby="@(_emailError is not null ? "email-error" : EmailLocked ? "email-locked" : null)" />
                @if (_emailError is not null)
                {
                    <p id="email-error" class="mt-1 text-sm text-destructive-strong" role="alert" data-testid="register-email-error" data-code="@_errorCode">
                        @_emailError
                        @if (_errorCode == ApiErrorCodes.EmailTaken)
                        {
                            @(" ")<a href="@LoginHref" class="font-medium underline">@T("auth.login")</a>
                        }
                    </p>
                }
                else if (EmailLocked)
                {
                    <p id="email-locked" class="mt-1 text-xs text-muted-foreground">@T("auth.emailLockedHint")</p>
                }
            </div>

            <div>
                <label for="password" class="hf-label">@T("auth.password")</label>
                <input id="password" type="password" autocomplete="new-password" @bind="_password" @bind:event="oninput"
                       required minlength="8" pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z0-9]).{8,}$"
                       title="@T("auth.passwordRequirement")" placeholder="••••••••••••" class="hf-input"
                       aria-describedby="password-hint" />
                <p id="password-hint" class="mt-1 text-xs text-muted-foreground">@T("auth.passwordRequirement")</p>
            </div>

            @* RGPD Art. 6(1)(b) / EDPB LD 05/2020 — acceptation CONTRACTUELLE des CGU :
               case obligatoire, non pré-cochée, portant sur un seul objet. Ce n'est pas un
               consentement au traitement des données : la base légale du compte est le
               contrat, et l'information sur la politique de confidentialité (Art. 13) est
               donnée séparément, sans case, juste en dessous du bouton. *@
            <div class="flex items-start gap-2.5">
                <input id="acceptTerms" type="checkbox" @bind="_acceptTerms"
                       class="mt-0.5 h-4 w-4 shrink-0 rounded border-input accent-primary" />
                <label for="acceptTerms" class="text-sm text-foreground">
                    @T("auth.acceptTerms")<a href="/@Locale/terms" target="_blank" rel="noopener noreferrer" class="hf-link">@T("auth.termsLinkLabel")</a>@T("auth.acceptTermsSuffix")
                </label>
            </div>

            @* Visible label "Continuer" (P03); the accessible name also says what the step does. *@
            <button type="submit" disabled="@(_busy || !_acceptTerms || _invitationLoading)" class="hf-btn hf-btn-primary w-full"
                    aria-label="@(IsInvitationMode ? null : T("auth.registerAndContinue"))" data-testid="register-submit">
                <BusyLabel Busy="_busy">@(IsInvitationMode ? T("auth.createAndJoin") : T("auth.continue"))</BusyLabel>
            </button>

            @* Mention d'information (Art. 13), sans case à cocher : la prise de connaissance
               de la politique n'est pas une autorisation à demander. *@
            <p class="text-[12.5px] text-muted-foreground">
                @T("auth.privacyNotice")<a href="/@Locale/privacy" target="_blank" rel="noopener noreferrer" class="hf-link">@T("auth.privacyLinkLabel")</a>@T("auth.privacyNoticeSuffix")
            </p>

            <p class="text-center text-sm text-muted-foreground">
                @T("auth.alreadyHaveAccount")
                <a href="@LoginHref" class="hf-link">@T("auth.login")</a>
            </p>
        </form>
    </div>
</div>

@code {
    [Parameter] public new string Locale { get; set; } = "fr";

    /// <summary>Invitation token (P04 "Créer un compte").</summary>
    [SupplyParameterFromQuery(Name = "invitation")] public string? Invitation { get; set; }

    /// <summary>R6: page to come back to, forwarded by P02 (validated by AppRoutes.SafeReturnUrl).</summary>
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    /// <summary>
    /// The invitation being answered: ?invitation= (P04 "Créer un compte"), or the P04 page carried
    /// by the returnUrl (P04 → "J'ai déjà un compte" → P02 → "Créer un compte"), so the invitation
    /// variant is kept on that path too.
    /// </summary>
    private string? InvitationToken => !string.IsNullOrWhiteSpace(Invitation)
        ? Invitation
        : AppRoutes.InvitationTokenOf(ReturnUrl);

    private string _firstName = "";
    private string _lastName = "";
    private string _email = "";
    private string _password = "";
    private bool _acceptTerms;
    private bool _busy;
    private string? _error;
    private string? _emailError;
    private string? _errorCode;

    private string? _loadedToken;
    private bool _invitationLoading;
    private InvitationInfo? _invitation;
    private bool _invitationUnusable;

    /// <summary>A usable invitation was found for the token: invitation variant of P03.</summary>
    private bool IsInvitationMode => _invitation is not null;

    private bool EmailLocked => IsInvitationMode && !string.IsNullOrEmpty(_invitation!.Email);

    private string LoginHref
    {
        get
        {
            var ret = IsInvitationMode
                ? $"/{Locale}/invitations/{Uri.EscapeDataString(InvitationToken!)}?accept=1"
                : AppRoutes.SafeReturnUrl(ReturnUrl);
            return ret is null ? $"/{Locale}/login" : $"/{Locale}/login?returnUrl={Uri.EscapeDataString(ret)}";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        base.OnInitialized();
        var invitationToken = InvitationToken;
        if (invitationToken == _loadedToken) return;
        _loadedToken = invitationToken;
        _invitation = null;
        _invitationUnusable = false;
        if (string.IsNullOrWhiteSpace(invitationToken)) return;

        _invitationLoading = true;
        try
        {
            var info = await Api.GetInvitationInfoAsync(invitationToken);
            if (info.IsExpired)
            {
                _invitationUnusable = true;
            }
            else
            {
                _invitation = info;
                if (!string.IsNullOrEmpty(info.Email)) _email = info.Email;
            }
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or TaskCanceledException)
        {
            // Unknown token (404) or unreachable API: plain registration, with a notice saying the
            // invitation is not applied (never a silent fallback).
            _invitationUnusable = true;
        }
        finally
        {
            _invitationLoading = false;
        }
    }

    private async Task Submit()
    {
        if (_busy) return;
        // The button is disabled without the acceptance; this guards a submit with the Enter key.
        if (!_acceptTerms)
        {
            _error = T("auth.termsRequired");
            return;
        }

        _busy = true;
        _error = null;
        _emailError = null;
        _errorCode = null;
        try
        {
            var token = IsInvitationMode ? InvitationToken : null;
            var res = await Api.RegisterAsync(
                new RegisterRequest(_firstName.Trim(), _lastName.Trim(), _email.Trim(), _password, ConsentAccepted: true), token);
            await Tokens.SetSessionAsync(res.AccessToken, AuthUser.FromDto(res.User));
            AuthState.NotifyChanged();
            Redirect.SetFormRedirecting();

            if (token is not null)
            {
                if (!string.IsNullOrEmpty(res.JoinedHouseId))
                {
                    Toasts.Show(T("invitations.joined", new { house = _invitation!.HouseName }));
                    Nav.NavigateTo($"/{Locale}/houses/{res.JoinedHouseId}", replace: true);
                }
                else
                {
                    // Not joined (should not happen: the API rejects bad tokens) → P04 decides.
                    Nav.NavigateTo($"/{Locale}/invitations/{Uri.EscapeDataString(token)}", replace: true);
                }
                return;
            }

            // P03 → P05, unless P02 forwarded a page to come back to (e.g. an invitation, P04 state B).
            Nav.NavigateTo(AppRoutes.SafeReturnUrl(ReturnUrl) ?? $"/{Locale}/setup/house", replace: true);
        }
        catch (ApiException ex)
        {
            _errorCode = ex.Code;
            switch (ex.Code)
            {
                case ApiErrorCodes.EmailTaken:
                    _emailError = T("auth.emailTaken");
                    break;
                case ApiErrorCodes.InvitationEmailMismatch:
                    _emailError = T("auth.invitationEmailMismatch");
                    break;
                case ApiErrorCodes.InvitationInvalid:
                    // The invitation died meanwhile: fall back to a plain registration.
                    _invitation = null;
                    _invitationUnusable = true;
                    break;
                default:
                    _error = ex.StatusCode == 409 ? T("auth.emailTaken") : T("auth.registerError");
                    break;
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            _error = T("common.unexpectedError");
        }
        finally
        {
            _busy = false;
        }
    }
}
