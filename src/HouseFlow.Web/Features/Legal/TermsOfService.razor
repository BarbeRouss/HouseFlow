@page "/{Locale}/terms"
@layout MainLayout
@inherits AppComponentBase

@* P15 · Page accessible SANS authentification (MainLayout) : les CGU doivent être lisibles avant
   l'inscription, puisque leur acceptation conditionne la création du compte. Ni C1 ni C8. *@

<LegalPage Title="@T("legal.termsTitle")">
    @if (Locale == "en")
    {
        <TermsContentEn />
    }
    else
    {
        <TermsContentFr />
    }
</LegalPage>

@code {
    [Parameter] public new string Locale { get; set; } = "fr";
}
