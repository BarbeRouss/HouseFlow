@page "/{Locale}/privacy"
@layout MainLayout
@inherits AppComponentBase

@* P14 · RGPD Art. 12(1)/13 — page accessible SANS authentification (checklist A.1) : elle utilise
   MainLayout, qui n'impose ni redirection vers le tableau de bord (AuthLayout) ni session
   valide (DashboardLayout), et n'affiche ni C1 ni C8 même connecté. *@

<LegalPage Title="@T("legal.privacyTitle")">
    @if (Locale == "en")
    {
        <PrivacyContentEn />
    }
    else
    {
        <PrivacyContentFr />
    }
</LegalPage>

@code {
    [Parameter] public new string Locale { get; set; } = "fr";
}
