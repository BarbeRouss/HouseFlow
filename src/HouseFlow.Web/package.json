{
  "name": "houseflow-web-css",
  "private": true,
  "description": "Tailwind CSS build tooling for the HouseFlow Blazor WebAssembly frontend.",
  "scripts": {
    "build:css": "tailwindcss -i ./Styles/app.input.css -o ./wwwroot/css/app.css --minify",
    "watch:css": "tailwindcss -i ./Styles/app.input.css -o ./wwwroot/css/app.css --watch"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7"
  }
}
