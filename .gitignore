# .NET artifacts
bin/
obj/
*.user
*.suo
*.sln.DotSettings.user
.vs/
.idea/
*.swp
*~

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa]ppHost
*.log

# Node.js
node_modules/
.next/
out/
.cache/
*.tsbuildinfo

# Environment files
.env
.env.local
.env.*.local

# Configuration with secrets (keep Template files only)
appsettings.Development.json
appsettings.Production.json
appsettings.Staging.json

# Regenerated at every build by HouseFlow.Web's WriteRuntimeConfig MSBuild target
# from the API_BASE_URL environment variable (see HouseFlow.Web.csproj) — the API's
# port is only known at run time (Aspire assigns it dynamically per environment/worktree).
src/HouseFlow.Web/wwwroot/appsettings.json

# OS files
.DS_Store
Thumbs.db
nul

# Temporary files
temp/
tmp/
*.tmp

# Test results
TestResults/
test-results/
playwright-report/
*.trx

# Terraform
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
# Exception : les instances de la racine `environment` sont la définition même
# des environnements (nom, TTL, hôtes DNS, options) et ne portent aucun secret
# — ceux-ci arrivent en -var depuis les secrets GitHub. Sans elles versionnées,
# la prod et son miroir ne seraient plus reproductibles.
!infrastructure/terraform/environment/instances/*.tfvars
.terraform/
.terraform.lock.hcl
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# IDE
.vscode/
*.code-workspace

# Claude Code parallel worktrees
.claude/worktrees/
.claude/settings.local.json

# CA du proxy d'egress déposée par scripts/feature-env.sh dans le contexte de build
# (Claude Code web / proxy d'entreprise) — jamais committée
.devcontainer/proxy-ca.crt
