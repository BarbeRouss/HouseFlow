# Variables sensibles des deux racines Terraform. Ne JAMAIS committer un
# terraform.tfvars réel — en CI, tout ceci arrive en TF_VAR_* depuis les secrets
# GitHub, et ce fichier ne sert qu'à un apply manuel de dépannage.
#
# Les variables NON sensibles qui définissent un environnement (nom, hôtes DNS,
# bastion, charge) ne sont pas ici : elles vivent dans
# `environment/instances/*.tfvars`, versionnées, parce qu'un environnement doit
# être reproductible.

subscription_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# ── shared ───────────────────────────────────────────
# Le storage account des states de CETTE souscription (nom unique au niveau
# mondial, créé au bootstrap avant tout apply).
tfstate_storage_account_name = "sthouseflowtfstatexxx"

# ── environment ──────────────────────────────────────
# Administrateur Entra du serveur PostgreSQL (accès psql via le bastion).
entra_admin_object_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
entra_admin_name      = "user@example.com"

# URI du Key Vault portant le certificat wildcard — slash final obligatoire.
key_vault_uri = "https://kv-houseflow.vault.azure.net/"

bastion_ssh_public_key = "ssh-ed25519 AAAA..."

# GHCR (PAT classique, portée read:packages)
ghcr_pat      = "ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
ghcr_username = "barberouss"

jwt_key = "CHANGE_ME_MINIMUM_32_CHARS_SECRET_KEY_FOR_JWT"

# Tag des images applicatives (posé par la CI, "latest" pour un apply manuel).
image_tag = "latest"
